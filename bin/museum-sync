#!/usr/bin/env python3
"""Back up local agent sessions to the museum store. Append-only: nothing is ever deleted.

  museum-sync --if-due        sync if the last one started over MUSEUM_INTERVAL ago
  museum-sync [--now]         sync now; if a sync is already running, it runs again after
  museum-sync --hook HARNESS  a harness hook: SessionStart writes the meta record
  museum-sync init [STORE [MACHINE]] [--hooks LIST|all] [--no-hooks]
                              set this machine up (`museum init`): config, harness
                              hooks and skills, PATH, the first sync, the timer
  museum-sync status          this machine's last sync, then every machine's museum
  museum-sync doctor          check this machine's setup, with the fix for each problem
  museum-sync tick            start a sync, detached, if one is due and sessions changed
  museum-sync timer install|remove   run `museum tick` every 5 minutes (launchd or systemd)

Every harness's sessions go to <store>/<machine>/<harness>/<project folder>/. pi's
are copied as they are; claude's, codex's and cursor-agent's go through a filter
first (see stage()). Only `museum tick` (the timer, tmux) and `museum sync` start a
sync: hooks run in harness sandboxes that may refuse ssh and rsync, so they only
write meta records.

A timer, tmux and a hand-run sync can call this at once, so at most one sync runs per node.
The lock is flock(2) on a file descriptor: it dies with its holder, so a crash or
reboot cannot leave it held. A caller that finds the lock taken exits 0 at once;
with --now it first leaves a `pending` mark, and the holder syncs again before it
lets go.

Config: ~/.config/museum/config.toml

  machine = "my-laptop"      this machine's folder in the store: <store>/<machine>/
  rsync_path = "/opt/homebrew/bin/rsync"   the rsync 3 to run, pinned at install;
                                          PATH's when left out

  [store]
  host = "devbox"            the store host, over ssh; leave it out for a local store
  path = "/data/museum"      the store folder, absolute, on the store host
  ssh_mux_only = false       sync only through an ssh ControlMaster that is already
                             open, never a new connection: for a store host whose
                             login needs a security-key touch or other human step

A machine still on the old KEY=value `config` is converted to config.toml on its
first sync, and the old file is kept as config.old.
"""

from __future__ import annotations

import argparse
import contextlib
import fcntl
import io
import json
import os
import plistlib
import re
import shlex
import shutil
import socket
import subprocess
import sys
import time
from collections.abc import Iterator, Mapping
from datetime import datetime
from pathlib import Path
from typing import Any, NamedTuple, TextIO

HOME = Path.home()
ROOT = Path(__file__).resolve().parent.parent  # the museum folder: a checkout or the npm package
# Exit status of copy() when ssh_mux_only is set and no master is running.
NO_MASTER = 90
# rsync's "some files vanished before they could be transferred": fine here.
RSYNC_VANISHED = 24
# BatchMode: never prompt. The timeouts bound a hung connection, which would
# otherwise hold the lock (and every later sync on this node) indefinitely.
SSH = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10"]
SSH += ["-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=3"]
# Mux-only: a session over a master skips auth, so disabling every method
# changes nothing there, but if the master dies between the check and rsync,
# the fresh connection fails instead of asking for a key touch.
NO_AUTH = [
    f"-o{m}=no"
    for m in (
        "PubkeyAuthentication",
        "PasswordAuthentication",
        "KbdInteractiveAuthentication",
        "GSSAPIAuthentication",
        "HostbasedAuthentication",
    )
]


# --- config: the same in museum-search; test_config checks they match ---


class ConfigError(Exception):
    pass


class Config(NamedTuple):
    machine: str
    host: str | None
    path: str
    ssh_mux_only: bool
    rsync_path: str | None = None  # the rsync the sync runs; found on PATH when unset

    def target(self) -> str:
        """The store folder in rsync's syntax: host:/path or /path."""
        return f"{self.host}:{self.path}" if self.host else self.path


def config_path() -> Path:
    return Path(os.environ.get("MUSEUM_CONFIG", Path.home() / ".config/museum/config.toml"))


def load_config(path: Path) -> Config:
    """config.toml, checked strictly: a typo is an error, not a default."""
    # Deliberately unreachable on the 3.11 target: an older python3 found on
    # PATH gets this message, in pi's footer too, not an ImportError.
    if sys.version_info < (3, 11):  # noqa: UP036
        raise ConfigError(
            f"needs Python 3.11+ for tomllib; {sys.executable} is {sys.version.split()[0]}"
        )
    import tomllib

    try:
        doc = tomllib.loads(path.read_text())
    except FileNotFoundError:
        raise ConfigError(f"missing {path}; run museum init") from None
    except (OSError, tomllib.TOMLDecodeError) as e:
        raise ConfigError(f"{path}: {e}") from None

    def table(value: object, where: str, keys: set[str]) -> dict[str, object]:
        if not isinstance(value, dict):
            raise ConfigError(f"{path}: {where} must be a table")
        unknown = sorted(set(value) - keys)
        if unknown:
            raise ConfigError(f"{path}: unknown key {where}.{unknown[0]}".replace(" .", " "))
        return value

    def text(value: object, key: str) -> str:
        if not isinstance(value, str) or not value:
            raise ConfigError(f"{path}: {key} must be a non-empty string")
        return value

    top = table(doc, "", {"machine", "rsync_path", "store"})
    store = table(top.get("store"), "store", {"host", "path", "ssh_mux_only"})
    machine = text(top.get("machine"), "machine")
    if "/" in machine:
        raise ConfigError(f"{path}: machine is a folder name, without /")
    rsync = text(top["rsync_path"], "rsync_path") if "rsync_path" in top else None
    if rsync and not rsync.startswith("/"):
        raise ConfigError(f"{path}: rsync_path must be absolute")
    host = text(store["host"], "store.host") if "host" in store else None
    if host and (":" in host or "/" in host):
        raise ConfigError(f"{path}: store.host is an ssh host; put the folder in store.path")
    folder = text(store.get("path"), "store.path")
    if not folder.startswith("/"):
        raise ConfigError(f"{path}: store.path must be absolute")
    mux = store.get("ssh_mux_only", False)
    if not isinstance(mux, bool):
        raise ConfigError(f"{path}: store.ssh_mux_only must be true or false")
    if mux and not host:
        raise ConfigError(f"{path}: store.ssh_mux_only needs store.host")
    return Config(machine, host, folder.rstrip("/") or "/", mux, rsync)


# --- end config ---


TEMPLATE = """\
# museum: https://github.com/mu-crew/museum

# This machine's folder in the store: sessions go to <store path>/<machine>/.
# Pinned at install, so a hostname change keeps using the same folder.
machine = {machine}

# The rsync 3 the sync runs, pinned at install: a timer, tmux and harness hooks
# start the sync with a PATH of their own. Left out, the sync looks on PATH.
{rsync}

[store]
# The store is on another host, over ssh, when `host` is set, and in a folder
# on this machine when it is not. Only `host` decides.
#
#   ssh:    host = "devbox"            local:  (no host line)
#           path = "/data/museum"              path = "/data/museum"
#
# `path` is absolute, on whichever host holds the store. A local store's
# folder must already exist, so a forgotten `host` line fails instead of
# quietly backing up to this machine.
{host}path = {path}

# ssh only. true: sync only over an ssh ControlMaster that is already open,
# never a new connection, for a store host whose login needs a security-key
# touch or another human step. Open one with `ssh -MNf <host>`.
ssh_mux_only = {mux}
"""


RSYNC_EXAMPLE = '# rsync_path = "/opt/homebrew/bin/rsync"'


def toml(c: Config) -> str:
    """A Config as config.toml, commented. JSON strings are valid TOML basic
    strings. `museum init` and convert_legacy write it."""

    def q(s: str) -> str:
        return json.dumps(s, ensure_ascii=False)

    return TEMPLATE.format(
        machine=q(c.machine),
        host=f"host = {q(c.host)}\n" if c.host else "",
        path=q(c.path),
        mux="true" if c.ssh_mux_only else "false",
        rsync=f"rsync_path = {q(c.rsync_path)}" if c.rsync_path else RSYNC_EXAMPLE,
    )


def convert_legacy(path: Path) -> None:
    """Write config.toml from the old KEY=value `config` beside it, once, and
    keep the old file as config.old. Remove when no machine has one left."""
    old = path.with_name("config")
    if path.exists() or not old.is_file():
        return
    values = {}
    for line in old.read_text().splitlines():
        for word in shlex.split(line, comments=True):
            key, eq, value = word.partition("=")
            if eq:
                values[key] = value
    store = values.get("STORE", "")
    host, sep, folder = store.partition(":") if ":" in store else ("", "", store)
    legacy = Config(
        machine=values.get("NAME") or socket.gethostname().split(".")[0],
        host=host if sep else None,
        path=folder,
        ssh_mux_only=bool(values.get("SSH_MUX_ONLY")),
    )
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(toml(legacy))
    tmp.replace(path)
    old.replace(old.with_name("config.old"))


class Source(NamedTuple):
    """A harness's session folder, walked recursively."""

    harness: str
    root: Path


class Settings(NamedTuple):
    config: Config
    src: Path
    state: Path
    interval: int
    retry_delay: int
    sources: tuple[Source, ...] = ()


class Result(NamedTuple):
    code: int
    output: str


def state_dir() -> Path:
    if "MUSEUM_STATE_DIR" in os.environ:
        return Path(os.environ["MUSEUM_STATE_DIR"])
    xdg = os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state"
    return Path(xdg) / "museum"


def hook_dir() -> Path:
    """Where `museum hook` leaves meta records and the flush stamp: a fixed
    path, not state_dir(), because the hook and the sync run with different
    environments. Muse clears its hooks' environment, and a timer has no
    XDG_STATE_HOME. MUSEUM_STATE_DIR still wins, for tests."""
    if "MUSEUM_STATE_DIR" in os.environ:
        return Path(os.environ["MUSEUM_STATE_DIR"])
    return Path.home() / ".local/state/museum"


def settings() -> Settings:
    path = config_path()
    if sys.version_info >= (3, 11):  # noqa: UP036 (see load_config)
        convert_legacy(path)
    env = os.environ
    return Settings(
        config=load_config(path),
        src=pi_sessions(env),
        state=state_dir(),
        interval=int(env.get("MUSEUM_INTERVAL", "600")),
        retry_delay=int(env.get("MUSEUM_RETRY_DELAY", "30")),
        sources=harness_sources(env),
    )


def pi_sessions(env: Mapping[str, str]) -> Path:
    return Path(env.get("PI_SESSIONS_DIR") or HOME / ".pi/agent/sessions")


def harness_sources(env: Mapping[str, str]) -> tuple[Source, ...]:
    """Where claude, codex and cursor-agent keep sessions, honouring their own
    home variables. cursor-agent's live SQLite chats are not copied; its
    greppable agent-transcripts under projects/ are. Muse Code's store is not
    known yet."""
    claude = Path(env.get("CLAUDE_CONFIG_DIR") or HOME / ".claude")
    codex = Path(env.get("CODEX_HOME") or HOME / ".codex")
    cursor = Path(env.get("CURSOR_HOME") or HOME / ".cursor")
    return (
        Source("claude", claude / "projects"),
        Source("codex", codex / "sessions"),
        Source("cursor-agent", cursor / "projects"),
    )


def find_rsync(configured: str | None = None) -> str | None:
    """The configured rsync_path if it is rsync 3, else none. Without one, the
    first rsync 3: PATH's, then Homebrew's. macOS /usr/bin/rsync is openrsync,
    which lacks --append-verify."""
    found = (shutil.which("rsync"), "/opt/homebrew/bin/rsync", "/usr/local/bin/rsync")
    for candidate in (configured,) if configured else found:
        if not candidate or not os.access(candidate, os.X_OK):
            continue
        try:
            out = subprocess.run(
                [candidate, "--version"], capture_output=True, text=True, check=False
            ).stdout
        except OSError:
            continue
        if re.match(r"rsync\s+version 3", out):
            return candidate
    return None


def run(cmd: list[str]) -> Result:
    """stdout and stderr merged, in the order the command wrote them. The lock
    fd is not inheritable (PEP 446), so neither ssh nor rsync, nor an orphan
    they leave behind, can keep holding the lock."""
    try:
        p = subprocess.run(
            cmd,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            errors="replace",
            check=False,
        )
    except OSError as e:
        return Result(1, f"{cmd[0]}: {e}")
    return Result(p.returncode, p.stdout)


# Moves what museum before 0.6 left at the top of a machine's folder, pi's
# <cwd folder>s and its oldest top-level sessions, into pi/, where every sync
# since puts them. It runs before every copy, as part of it, so a machine
# migrates its own folder on its first sync with this version and never
# touches another's; once moved, the globs match nothing. A file in both
# places is a session the old layout kept growing: the longer copy is kept in
# pi/, and the other is removed only when it is a prefix of it. Anything else
# is left where it is, with a line on stderr. $1: the machine's folder.
#
# It reaches the store host through rsync's --rsync-path, parsed first by the
# store host's login shell, so it is sent as one line (one_line) with no `!`
# outside `[ ! `: csh and tcsh reject a newline inside quotes and expand `!x`
# even inside them.
MIGRATE = r"""
PATH=$PATH:/usr/bin:/bin
cd "$1" || exit 1
fail() { echo "museum: migrate: $*" >&2; exit 1; }
size() { wc -c < "$1" | tr -d ' '; }
merge() {
  if [ ! -e "$2" ]; then
    mv "$1" "$2" || fail "cannot move $1"
    return
  fi
  a=$(size "$1") b=$(size "$2")
  if [ "$a" -gt "$b" ]; then
    head -c "$b" "$1" | cmp -s - "$2" && { mv -f "$1" "$2" || fail "cannot move $1"; }
  else
    head -c "$a" "$2" | cmp -s - "$1" && rm -f "$1"
  fi
  [ ! -e "$1" ] || echo "museum: migrate: left $1: it differs from $2" >&2
}
for d in ./--*-- ./*.jsonl; do
  [ -e "$d" ] || continue
  n=${d#./}
  mkdir -p pi || fail "cannot create pi/"
  if [ -d "$d" ] && [ -d "pi/$n" ]; then
    for f in "$d"/*; do
      [ -f "$f" ] && merge "$f" "pi/$n/${f##*/}"
    done
    rmdir "$d" 2> /dev/null || echo "museum: migrate: left $d: not empty" >&2
  else
    merge "$d" "pi/$n"
  fi
done
exit 0
"""


def one_line(script: str) -> str:
    """A shell script on one line: each line ends with `;` unless it opens a
    block or continues a list. Only for scripts written to allow it."""
    out = ""
    for line in filter(None, (raw.strip() for raw in script.splitlines())):
        out += line + (" " if line.endswith(("then", "do", "else", "{", "&&", "||", "|")) else "; ")
    return out.removesuffix("; ")


def pi_link(s: Settings) -> Path | None:
    """<state>/pi-link/pi, a link to pi's sessions folder: the copy sends it
    with --relative, so pi's sessions land in <machine>/pi/ in the same rsync
    as every other harness, and still copied as they are, not staged."""
    if not s.src.is_dir():
        return None
    link = s.state / "pi-link" / "pi"
    if not (link.is_symlink() and link.readlink() == s.src):
        link.parent.mkdir(parents=True, exist_ok=True)
        link.unlink(missing_ok=True)
        link.symlink_to(s.src)
    return link


def copy(s: Settings, rsync: str) -> Result:
    c = s.config
    ssh = SSH + NO_AUTH if c.ssh_mux_only else SSH
    extra = []
    here = f"{c.path}/{c.machine}"
    if c.host:
        # `-O check` only asks the local control socket; it never connects.
        if c.ssh_mux_only and run([*ssh, "-O", "check", c.host]).code != 0:
            return Result(NO_MASTER, f"no ssh master for {c.host} (run: ssh -MNf {c.host})")
        # The remote mkdir and the migration ride rsync's own connection, so a
        # sync opens one ssh connection, not two.
        migrate = shlex.quote(one_line(MIGRATE))
        prep = f"mkdir -p {shlex.quote(here)} && sh -c {migrate} migrate {shlex.quote(here)}"
        extra = [f"--rsync-path={prep} && rsync"]
    else:
        # Only the machine's folder is created, never the store folder: a
        # missing one most likely means a forgotten `host` line, and creating
        # it would back up to this machine and report success.
        if not Path(c.path).is_dir():
            return Result(1, f"store.path {c.path} does not exist here (is store.host missing?)")
        try:
            Path(here).mkdir(exist_ok=True)
        except OSError as e:
            return Result(1, f"mkdir: {e}")
        r = run(["/bin/sh", "-c", one_line(MIGRATE), "migrate", here])
        if r.code != 0:
            return r
        if r.output:
            print(r.output, file=sys.stderr, end="")
    # pi's sessions go as they are, through pi_link; the other harnesses'
    # filtered copies, the meta records and the version marker from the stage
    # folder. One rsync, so a sync opens one ssh connection. `/./` marks
    # where each source's path in the store starts.
    stage = s.state / STAGE
    link = pi_link(s)
    sources = [f"{link.parent}/./pi/"] if link else []
    sources += [f"{stage}/./"] if stage.is_dir() else []
    if not sources:
        return Result(0, "")
    r = run(
        [
            rsync,
            "-a",
            "--relative",
            "--append-verify",
            "--timeout=120",
            "--include=*/",
            "--include=*.jsonl",
            "--include=/*/meta/*.json",
            f"--include=/{VERSIONS}/*.json",
            "--exclude=*",
            *extra,
            "-e",
            " ".join(ssh),
            *sources,
            f"{c.target()}/{c.machine}/",
        ]
    )
    return Result(0, r.output) if r.code == RSYNC_VANISHED else r


# --- the filter: claude, codex and cursor-agent sessions, staged for the copy ---
#
# museum keeps a filtered copy of each non-pi session under
# <state>/stage/<harness>/<project folder>/, extended from a byte cursor, and
# syncs that. Sources only append, so the copy only grows and keeps
# --append-verify. A source that shrank is filtered again from scratch.

STAGE = "stage"
CAP = 64 * 1024  # bytes kept of one tool result
# claude: API request copies (every record type starting api-request: the
# request, its blob, and its shape, which holds the whole system prompt) and
# file snapshots, large and not the conversation.
CLAUDE_DROP_PREFIX = "api-request"
CLAUDE_DROP = frozenset({"file-history-snapshot"})
# codex: opaque reasoning, and the histories every compaction repeats in full.
CODEX_DROP = frozenset({"encrypted_content", "guardian_history", "replacement_history"})
# codex: the payload fields that carry a tool's output.
CODEX_OUTPUT = ("output", "aggregated_output", "formatted_output", "stdout", "stderr")
# A line can need the filter only if it is long or names what it drops, so the
# rest are copied without parsing.
MARKERS = {
    "claude": (b'"api-request', b'"file-history-snapshot"'),
    "codex": tuple(f'"{key}"'.encode() for key in sorted(CODEX_DROP)),
    # Real transcripts use `"type":"turn_ended"`; tests also cover role=.
    "cursor-agent": (b'"turn_ended"',),
}


def cap(value: object) -> object:
    """A tool result of at most CAP bytes. A longer one is cut, as text: the
    same object back means it was short enough. surrogatepass, because JSON
    can carry a lone surrogate (a string cut inside an emoji); the cut drops
    it."""
    text = value if isinstance(value, str) else json.dumps(value, ensure_ascii=False)
    data = text.encode(errors="surrogatepass")
    if len(data) <= CAP:
        return value
    return data[:CAP].decode(errors="ignore") + f"\n[museum: cut at {CAP} of {len(data)} bytes]"


def strip(value: object, keys: frozenset[str]) -> bool:
    """Delete `keys` at any depth, in place. True if anything went."""
    changed = False
    if isinstance(value, dict):
        for key in keys & value.keys():
            del value[key]
            changed = True
        items: list[object] = list(value.values())
    elif isinstance(value, list):
        items = value
    else:
        return False
    for item in items:
        changed = strip(item, keys) or changed
    return changed


def filter_entry(harness: str, entry: object) -> tuple[bool, bool]:
    """(keep, changed) for one parsed record, which is changed in place."""
    if not isinstance(entry, dict):
        return True, False
    changed = False

    def capped(d: object, key: str) -> None:
        nonlocal changed
        if isinstance(d, dict) and key in d:
            value = cap(d[key])
            if value is not d[key]:
                d[key] = value
                changed = True

    if harness == "claude":
        kind = entry.get("type")
        if isinstance(kind, str) and (kind.startswith(CLAUDE_DROP_PREFIX) or kind in CLAUDE_DROP):
            return False, False
        capped(entry, "toolUseResult")
        message = entry.get("message")
        content = message.get("content") if isinstance(message, dict) else None
        for block in content if isinstance(content, list) else []:
            if isinstance(block, dict) and block.get("type") == "tool_result":
                capped(block, "content")
    elif harness == "codex":
        changed = strip(entry, CODEX_DROP)
        for key in CODEX_OUTPUT:
            capped(entry.get("payload"), key)
    elif harness == "cursor-agent":
        # Observed Cursor JSONL uses type=turn_ended; role= was only a guess.
        if entry.get("type") == "turn_ended" or entry.get("role") == "turn_ended":
            return False, False
        message = entry.get("message")
        content = message.get("content") if isinstance(message, dict) else None
        for block in content if isinstance(content, list) else []:
            if not isinstance(block, dict):
                continue
            if block.get("type") == "tool_use":
                capped(block, "input")
            elif block.get("type") == "tool_result":
                capped(block, "content")
    return True, changed


def filter_line(harness: str, line: bytes) -> bytes | None:
    """One JSONL line as the store keeps it, or None to drop it. A line that is
    not JSON is kept as it is: this is a backup."""
    if len(line) <= CAP and not any(m in line for m in MARKERS[harness]):
        return line
    # RecursionError: nested too deep to parse or walk, which no harness writes.
    try:
        entry = json.loads(line)
        keep, changed = filter_entry(harness, entry)
    except (ValueError, RecursionError):
        return line
    if not keep:
        return None
    if not changed:
        return line
    try:
        text = json.dumps(entry, ensure_ascii=False, separators=(",", ":"))
        return (text + "\n").encode()
    except UnicodeEncodeError:  # a lone surrogate: keep it as JSON's \uXXXX escape
        return (json.dumps(entry, separators=(",", ":")) + "\n").encode()


def slug(path: str) -> str:
    """A cwd as a folder name, the way claude names its project folders:
    /home/u/proj is -home-u-proj. The leading - keeps it apart from `meta`."""
    return re.sub(r"[^A-Za-z0-9]", "-", path)


def codex_project(src: Path) -> str | None:
    """A codex rollout's project folder, from session_meta's cwd in its first
    line: the date folders say nothing about the project. None while that line
    is still being written."""
    with src.open("rb") as f:
        first = f.readline()
    if not first.endswith(b"\n"):
        return None
    try:
        cwd = json.loads(first)["payload"]["cwd"]
    except (ValueError, KeyError, TypeError):
        cwd = None
    return slug(cwd) if isinstance(cwd, str) and cwd else "-unknown"


def destination(source: Source, src: Path) -> str | None:
    """Where a source file's filtered copy goes, under the stage folder."""
    if source.harness == "codex":
        project = codex_project(src)
        return None if project is None else f"codex/{project}/{src.name}"
    if source.harness == "cursor-agent":
        # <project>/agent-transcripts/<id>/<id>.jsonl → cursor-agent/<project>/<id>.jsonl
        try:
            parts = src.relative_to(source.root).parts
        except ValueError:
            return None
        if len(parts) != 4 or parts[1] != "agent-transcripts" or parts[3] != f"{parts[2]}.jsonl":
            return None
        return f"cursor-agent/{parts[0]}/{parts[3]}"
    # claude's own folders are already per project; subagents stay beside
    # their session, in <uuid>/subagents/.
    return f"{source.harness}/{src.relative_to(source.root).as_posix()}"


Cursor = dict[str, Any]  # pos: source bytes read, out: bytes written, dest


def extend(harness: str, src: Path, out: Path, cur: Cursor) -> Cursor:
    """Filter the complete lines past the cursor onto the staged copy."""
    pos, written = cur["pos"], cur["out"]
    if src.stat().st_size < pos:  # shrank: not the file we read
        pos = written = 0
    have = out.stat().st_size if out.exists() else 0
    if have < written:  # the copy went missing or was cut: start over
        pos = written = 0
    out.parent.mkdir(parents=True, exist_ok=True)
    with src.open("rb") as fi, out.open("ab") as fo:
        # A crash after writing but before the cursor was saved leaves the
        # copy longer than the cursor says; cut it back.
        fo.truncate(written)
        fi.seek(pos)
        for line in fi:
            if not line.endswith(b"\n"):  # still being written
                break
            pos += len(line)
            kept = filter_line(harness, line)
            if kept is not None:
                fo.write(kept)
                written += len(kept)
    return {**cur, "pos": pos, "out": written}


def stage(state: Path, sources: tuple[Source, ...], hooks: Path) -> None:
    """Bring every staged copy, and every meta record under `hooks`, up to date. Every source file is
    stat'ed, not just recent ones: a codex rollout can grow months after its
    date folder. One file that cannot be read or filtered is skipped, never
    the rest, and their cursors are saved."""
    root = state / STAGE
    cursors_file = state / "stage.json"
    try:
        cursors: dict[str, Cursor] = json.loads(cursors_file.read_text())
    except (OSError, ValueError):
        cursors = {}
    for source in sources:
        if not source.root.is_dir():
            continue
        for src in sorted(source.root.rglob("*.jsonl")):
            key = str(src)
            cur = cursors.get(key)
            try:
                if cur is not None and src.stat().st_size == cur["pos"]:
                    continue
                if cur is None:
                    dest = destination(source, src)
                    if dest is None:
                        continue
                    cur = {"pos": 0, "out": 0, "dest": dest}
                cursors[key] = extend(source.harness, src, root / str(cur["dest"]), cur)
            except Exception as e:  # noqa: BLE001 (one bad file must not stop the rest)
                print(f"museum: skipped {src}: {type(e).__name__}: {e}", file=sys.stderr)
    # The meta records `museum hook` wrote, as <harness>/meta/<session id>.json.
    for record_file in sorted((hooks / "meta").glob("*/*.json")):
        out = root / record_file.parent.name / "meta" / record_file.name
        try:
            if not out.exists() or out.stat().st_size != record_file.stat().st_size:
                out.parent.mkdir(parents=True, exist_ok=True)
                shutil.copyfile(record_file, out)
        except OSError as e:
            print(f"museum: skipped {record_file}: {e}", file=sys.stderr)
    if cursors:
        write(cursors_file, json.dumps(cursors, sort_keys=True) + "\n")


# --- `museum hook HARNESS`: the meta record and the flush stamp ---

HOOKED = ("claude", "codex", "cursor-agent", "muse", "pi")
SAFE_ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*")


def git_meta(cwd: str) -> dict[str, str]:
    """The cwd's repo, as pi/museum.ts's meta() records it."""

    def git(*args: str) -> str:
        try:
            p = subprocess.run(
                ["git", "-C", cwd, *args],
                capture_output=True,
                text=True,
                timeout=3,
                check=False,
                stdin=subprocess.DEVNULL,
            )
        except (OSError, subprocess.SubprocessError):
            return ""
        return p.stdout if p.returncode == 0 else ""

    # --abbrev-ref applies to every argument after it, so the commit comes first.
    rev = git(
        "rev-parse", "--path-format=absolute", "--git-common-dir", "HEAD", "--abbrev-ref", "HEAD"
    )
    remote = git("config", "--get", "remote.origin.url").strip()
    common, commit, branch = [*rev.strip().split("\n"), "", "", ""][:3]
    # The common dir is <repo>/.git for a plain repo and for every worktree of it.
    repo = common[: -len("/.git")] if common.endswith("/.git") else ""
    return {
        "project": Path(repo).name if repo else "",
        "repo": repo,
        "remote": remote,
        "branch": branch if branch != "HEAD" else "",
        "commit": commit,
    }


def process_table() -> dict[int, tuple[int, str]]:
    """pid -> (ppid, argv), from one `ps`."""
    r = run(["ps", "-A", "-o", "pid=,ppid=,args="])
    table = {}
    for line in r.output.splitlines():
        parts = line.split(None, 2)
        if len(parts) >= 2 and parts[0].isdigit() and parts[1].isdigit():
            table[int(parts[0])] = (int(parts[1]), parts[2] if len(parts) == 3 else "")
    return table


# Every harness's process names, as mu's chain walk knows them. A launcher and
# its binary (`codex < codex.real`) are one harness.
HARNESSES = frozenset({"claude", "codex", "cursor-agent", "muse", "pi"})


def harness_of(args: str) -> str | None:
    """The harness a process runs, by argv, not by process name: pi and
    cursor-agent can run as `node` or `bun`, with the harness in the script's
    path."""
    words = args.split(maxsplit=2)
    if not words:
        return None
    exe = Path(words[0])
    if exe.name in ("node", "bun"):
        if len(words) < 2:
            return None
        script = Path(words[1])
        return next((n for n in (script.stem, *script.parts) if n in HARNESSES), None)
    name = exe.name.removesuffix(".real")
    return name if name in HARNESSES else None


def started(pid: int) -> float | None:
    """A process's start time, epoch seconds, to the second."""
    try:
        out = subprocess.run(
            ["ps", "-o", "lstart=", "-p", str(pid)],
            capture_output=True,
            text=True,
            check=False,
            env={**os.environ, "LC_ALL": "C"},
        ).stdout
        return time.mktime(time.strptime(" ".join(out.split()), "%a %b %d %H:%M:%S %Y"))
    except (OSError, ValueError):
        return None


def epoch(value: object) -> float | None:
    """An anchor's start time: epoch seconds or milliseconds, ISO 8601, or ps's
    lstart text."""
    if isinstance(value, bool):
        return None
    if isinstance(value, (int, float)):
        return value / 1000 if value > 1e11 else float(value)
    if isinstance(value, str):
        with contextlib.suppress(ValueError):
            return datetime.fromisoformat(value).timestamp()
        with contextlib.suppress(ValueError):
            return time.mktime(time.strptime(" ".join(value.split()), "%a %b %d %H:%M:%S %Y"))
    return None


def pick(doc: dict[str, Any], *keys: str) -> Any:
    return next((doc[k] for k in keys if doc.get(k) not in (None, "")), None)


def find_anchor(harness: str) -> dict[str, Any] | None:
    """mu's anchor for the agent this hook runs under: the first ancestor
    with an anchor file whose start time matches the process, so a reused pid
    cannot lend its identity. {} when that anchor is not this session's: it
    is another harness's, or the walk left this session's harness before
    reaching it, through a shell to an outer agent of any harness. Either way
    the session is nested and has no mu identity of its own. None when there
    is no anchor, and the environment is the fallback."""
    anchors = Path.home() / ".local/state/mu-next/anchors"
    if not anchors.is_dir():
        return None
    procs = process_table()
    pid, seen = os.getppid(), set()
    ours: str | None = None  # the first harness on the chain: this session's
    left = False  # the walk has passed beyond it
    while pid > 1 and pid not in seen:
        seen.add(pid)
        doc = read_anchor(anchors / f"{pid}.json", pid)
        if doc is not None:
            cli = pick(doc, "cli", "harness")
            return {} if left or (cli and cli != harness) else doc
        ppid, args = procs.get(pid, (0, ""))
        kind = harness_of(args)
        if ours is None:
            ours = kind
        elif kind != ours:
            left = True
        pid = ppid
    return None


def read_anchor(path: Path, pid: int) -> dict[str, Any] | None:
    """An anchor file, if it is there, parses, and was written for this very
    process. One without a start time is taken as it is."""
    try:
        doc = json.loads(path.read_text())
    except (OSError, ValueError):
        return None
    if not isinstance(doc, dict):
        return None
    when = pick(doc, "start_time", "started", "startTime")
    if when is None:
        return doc
    actual, expected = started(pid), epoch(when)
    return doc if actual and expected and abs(actual - expected) <= 2 else None


def identity(harness: str, env: Mapping[str, str]) -> dict[str, str]:
    """Agent, role and workstream exist only in mu's anchor or the agent's env.
    The anchor's role wins, then its orchestrator flag. In the env, as in mu,
    a managed agent is a worker unless MU_ORCHESTRATOR is "1"."""
    anchor = find_anchor(harness)
    if anchor is not None:
        agent = pick(anchor, "agent", "agent_name", "name")
        workstream = pick(anchor, "workstream")
        role = pick(anchor, "role")
        if not isinstance(role, str):
            orchestrator = anchor.get("orchestrator") in (True, 1, "1", "true")
            role = "orchestrator" if orchestrator else ""
    else:
        agent, workstream = env.get("MU_AGENT_NAME"), env.get("MU_WORKSTREAM")
        if env.get("MU_ORCHESTRATOR") == "1":
            role = "orchestrator"
        elif env.get("MU_MANAGED_AGENT") == "1":
            role = "worker"
        else:
            role = ""
    return {
        "agent": agent if isinstance(agent, str) else "",
        "workstream": workstream if isinstance(workstream, str) else "",
        "role": role,
    }


def write_meta(harness: str, payload: dict[str, Any], env: Mapping[str, str]) -> None:
    """<state>/meta/<harness>/<session id>.json, once: a resumed session keeps
    its first record. museum never writes into another harness's transcript."""
    sid = payload.get("session_id")
    if not isinstance(sid, str) or not SAFE_ID.fullmatch(sid):
        return
    path = hook_dir() / "meta" / harness / f"{sid}.json"
    if path.exists():
        return
    cwd = payload.get("cwd")
    if not (isinstance(cwd, str) and cwd):
        roots = payload.get("workspace_roots")
        root = roots[0] if isinstance(roots, list) and roots else None
        cwd = root if isinstance(root, str) and root else str(Path.cwd())
    doc = {
        "harness": harness,
        "session_id": sid,
        "cwd": cwd,
        "time": datetime.now().astimezone().isoformat(timespec="seconds"),
        **git_meta(cwd),
        **identity(harness, env),
    }
    if not doc["project"]:
        doc["project"] = doc["workstream"]
    path.parent.mkdir(parents=True, exist_ok=True)
    write(path, json.dumps({k: v for k, v in doc.items() if v}) + "\n")


def hook(harness: str, stdin: TextIO) -> int:
    """One harness hook call, its payload on stdin: SessionStart writes the
    meta record, which only a process in the session's own tree can learn
    (mu's anchor, its environment, the repo as it was). Nothing syncs here: a
    sandboxed hook cannot run rsync or ssh, and `museum tick`, outside every
    sandbox, syncs what changed. Other events, from older installs' entries,
    do nothing. A hook never breaks a turn, so every problem is a line on
    stderr and exit 0, and nothing goes to stdout, which claude would show
    the model. pi's extension calls this too, with the same payload."""
    try:
        if harness not in HOOKED:
            print(f"museum: no backup for {harness} sessions", file=sys.stderr)
            return 0
        payload = json.loads(stdin.read() or "{}")
        if not isinstance(payload, dict):
            return 0
        # codex's hidden title-generation session fires every event.
        if harness == "codex" and "transcript_path" in payload and not payload["transcript_path"]:
            return 0
        event = str(payload.get("hook_event_name", "")).lower()
        if event == "sessionstart":
            write_meta(harness, payload, os.environ)
    except Exception as e:  # noqa: BLE001 (a hook never breaks a turn)
        print(f"museum: hook {harness}: {type(e).__name__}: {e}", file=sys.stderr)
    # cursor-agent treats empty stdout as a failed hook (`empty_stdout`);
    # murmur and muzzle reply `{}` for the same reason.
    if harness == "cursor-agent":
        print("{}")
    return 0


def error_line(output: str) -> str:
    """ssh's or the remote mkdir's line says why; rsync's last line after it is
    only "connection unexpectedly closed" / "protocol data stream"."""
    lines = [line for line in output.splitlines() if line.strip()]
    why = [line for line in lines if re.match(r"(ssh|mkdir|museum): ", line)]
    return (why or lines or [""])[-1]


def write(path: Path, text: str) -> None:
    """Atomically, so a pi polling the file never reads half of it."""
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(text)
    tmp.replace(path)


def warning(status: str, message: str) -> str:
    """pi's footer label, empty while backups work. Every pi on the node shows
    this file as it is, so the rule for the label lives here, in one place."""
    if status != "error":
        return ""
    hint = " · museum doctor"
    return f"museum: backup failing: {message}"[: 120 - len(hint)] + hint


def record(state: Path, status: str, message: str, started: int | None = None) -> None:
    """state.json: the last sync's result, the footer label every pi shows,
    and last_ok, when the last sync that worked started, which pi's footer
    reads to tell a stale backup. `started` is set when this one worked."""
    message = " ".join(message.split())
    last_ok = started
    if last_ok is None:
        try:
            last_ok = int(json.loads((state / "state.json").read_text()).get("last_ok", 0)) or None
        except (OSError, ValueError, TypeError, AttributeError):
            last_ok = None
    doc = {
        "status": status,
        "time": int(time.time()),
        "message": message,
        "warning": warning(status, message),
        **({"last_ok": last_ok} if last_ok else {}),
    }
    write(state / "state.json", json.dumps(doc) + "\n")


def mark_ok(state: Path, started: int) -> None:
    """`last-ok`, whose mtime is when the last sync that worked started: `museum
    tick` syncs only when a session file is newer (find -newer). A second
    early, so a file written in the second the sync started is not missed."""
    ok = state / "last-ok"
    ok.touch()
    os.utime(ok, (started - 1, started - 1))


def sync_once(s: Settings, rsync: str | None) -> bool:
    (s.state / "pending").unlink(missing_ok=True)
    started = int(time.time())
    (s.state / "last-start").write_text(f"{started}\n")
    if rsync is None:
        configured = s.config.rsync_path
        why = f"rsync_path {configured} is not rsync 3.x" if configured else "rsync 3.x not found"
        record(s.state, "error", f"{why} (macOS: brew install rsync)")
        return False
    # A filter failure must not cost pi its backup: the copy runs regardless,
    # with whatever staged copies there are.
    try:
        stage(s.state, s.sources, hook_dir())
    except Exception as e:  # noqa: BLE001 (pi's backup comes first)
        print(f"museum: filter: {type(e).__name__}: {e}", file=sys.stderr)
    try:
        mark_version(s.state, s.config.machine)
    except OSError as e:
        print(f"museum: version marker: {e}", file=sys.stderr)
    r = copy(s, rsync)
    # One retry, for a blip, only in mux-only mode with a live master: there it
    # costs no human step. A fresh connection may need a key touch, and a
    # missing master will not appear in retry_delay seconds.
    if r.code != 0 and s.config.ssh_mux_only and r.code != NO_MASTER:
        print(f"{r.output}museum: retrying in {s.retry_delay}s", file=sys.stderr)
        time.sleep(s.retry_delay)
        r = copy(s, rsync)
    if r.code == 0:
        mark_ok(s.state, started)
        record(s.state, "ok", "", started)
        return True
    record(s.state, "error", error_line(r.output))
    print(r.output, file=sys.stderr, end="")
    return False


SEARCH = ROOT / "skills/museum/scripts/museum-search"


def index(s: Settings) -> None:
    """Bring a local store's turn index up to date, so the next search finds
    it current. An ssh store's index is updated by the store host's own sync,
    or by the next search there. A failure costs only a slower search, so it
    goes to stderr, not the footer."""
    if s.config.host or not SEARCH.is_file():
        return
    r = run([sys.executable, str(SEARCH), "--store", s.config.path, "index"])
    if r.code != 0:
        print(f"museum: index: {r.output.strip()}", file=sys.stderr)


# --- the version: what this machine runs, reported through the store ---
#
# Each sync leaves <store>/<machine>/.museum/<version>[+<commit>].json, so
# `museum status` can list what every machine runs from the one place they all
# write to. One file per version, never rewritten: the copy is --append-verify,
# which would never update a file whose length stayed the same. rsync keeps the
# file's mtime, the time this machine first synced with that version.

VERSIONS = ".museum"


def version_info() -> dict[str, str]:
    """This museum's version (package.json), and its commit when it runs from
    a git checkout. source: npm (pi's npm package), checkout, or copy."""
    try:
        version = str(json.loads((ROOT / "package.json").read_text())["version"])
    except (OSError, ValueError, KeyError, TypeError):
        version = "unknown"
    info = {"version": version, "source": "copy", "commit": ""}
    if "node_modules" in ROOT.parts:
        info["source"] = "npm"
    elif (ROOT / ".git").exists():
        info["source"] = "checkout"
        r = run(["git", "-C", str(ROOT), "rev-parse", "--short", "HEAD"])
        if r.code == 0:
            info["commit"] = r.output.strip()
    return info


def version_label(info: dict[str, str]) -> str:
    return info["version"] + (f"+{info['commit']}" if info["commit"] else "")


def mark_version(state: Path, machine: str) -> None:
    """The version marker for the next copy, in the staged folder it rides."""
    info = version_info()
    out = state / STAGE / VERSIONS / f"{version_label(info)}.json"
    if out.exists():
        return
    out.parent.mkdir(parents=True, exist_ok=True)
    doc = {**info, "machine": machine, "root": str(ROOT)}
    write(out, json.dumps(doc, sort_keys=True) + "\n")


def due(s: Settings, if_due: bool) -> bool:
    if (s.state / "pending").exists():
        return True
    if not if_due:
        return False
    try:
        last = int((s.state / "last-start").read_text().strip())
    except (OSError, ValueError):
        last = 0
    return time.time() - last >= s.interval


# --- init: set this machine up, as `mu init`, `murmur init` and `muzzle init` do ---
#
# Run again after an upgrade, or any time: every step leaves what is already
# right alone. The harness config files are shared with mu, murmur, muzzle and
# the user, so museum owns exactly the hook handlers whose command's first word
# is `museum`, as murmur owns `murmur`'s, and the skill links that point at a
# museum skill folder. A file it cannot read as the shape it expects is named
# and left alone.

# Each harness's config folder (its variable, else under $HOME), the file in
# it, its shape and the events museum hooks. grouped: claude's
# hooks.<Event>[].hooks[] (codex and Muse too); flat: cursor's hooks.<event>[]
# beside a top-level version. As murmur's HOOK_TARGETS.
HOOK_TARGETS: dict[str, tuple[str | None, str, str, str, tuple[str, ...]]] = {
    "claude": (
        "CLAUDE_CONFIG_DIR",
        ".claude",
        "settings.json",
        "grouped",
        ("SessionStart",),
    ),
    "codex": ("CODEX_HOME", ".codex", "hooks.json", "grouped", ("SessionStart",)),
    "cursor-agent": (None, ".cursor", "hooks.json", "flat", ("sessionStart",)),
    "muse": (None, ".config/muse", "settings.json", "grouped", ("SessionStart",)),
}
# museum's handlers: `museum ...`, and a path to museum or museum-sync, which
# older setups wrote by hand. Those are replaced by the one `museum hook`.
OWNED = re.compile(r"""^(python3?\s+)?["']?(\S*/)?museum(-sync)?["']?(\s|$)""")


class Unworkable(Exception):
    pass


def harness_dir(harness: str, env: Mapping[str, str]) -> Path:
    var, home_dir, *_ = HOOK_TARGETS[harness]
    moved = env.get(var) if var else None
    return Path(moved).expanduser() if moved else Path.home() / home_dir


def plan_hooks(harness: str, root: dict[str, Any]) -> tuple[list[str], list[str], list[str]]:
    """Bring one parsed config in line with museum's entries, in place: per
    hooked event, keep the first handler that is exactly `museum hook
    <harness>` (with any field the user added; a missing `type` is set),
    remove every other museum handler, and add one where none is left. The
    events added, the handlers fixed, and the handlers removed."""
    *_, shape, events = HOOK_TARGETS[harness]
    hooks = root.get("hooks", {})
    if not isinstance(hooks, dict):
        raise Unworkable("its `hooks` is not an object")
    command = f"museum hook {harness}"
    kept: set[str] = set()
    added: list[str] = []
    fixed: list[str] = []
    removed: list[str] = []
    for event in list(hooks):
        entries = hooks[event]
        if not isinstance(entries, list):
            if event in events:
                raise Unworkable(f"its `hooks.{event}` is not a list")
            continue
        groups: list[tuple[dict[str, Any] | None, list[Any]]]
        if shape == "flat":
            groups = [(None, entries)]
        else:
            groups = [
                (g, g["hooks"])
                for g in entries
                if isinstance(g, dict) and isinstance(g.get("hooks"), list)
            ]
        before_removed = len(removed)
        for group, handlers in groups:
            before = len(handlers)
            for handler in list(handlers):
                if not isinstance(handler, dict) or not OWNED.match(
                    str(handler.get("command", "")).lstrip()
                ):
                    continue
                matches_all = group is None or group.get("matcher") in (None, "", "*")
                if (
                    event in events
                    and event not in kept
                    and handler.get("command") == command
                    and matches_all
                    and (shape == "flat" or handler.get("type", "command") == "command")
                ):
                    kept.add(event)
                    if shape == "grouped" and "type" not in handler:
                        handler["type"] = "command"
                        fixed.append(f"{event}: type")
                    continue
                handlers.remove(handler)
                removed.append(f"{event}: {handler.get('command')}")
            if group is not None and before and not handlers:
                entries.remove(group)
        if not entries and len(removed) > before_removed:
            del hooks[event]
    for event in events:
        if event in kept:
            continue
        handler = (
            {"command": command} if shape == "flat" else {"type": "command", "command": command}
        )
        hooks.setdefault(event, []).append(handler if shape == "flat" else {"hooks": [handler]})
        added.append(event)
    if added or fixed or removed:
        root["hooks"] = hooks
        if shape == "flat":
            root.setdefault("version", 1)  # cursor reads no hook file without it
    return added, fixed, removed


def reject_constant(name: str) -> None:
    raise ValueError(f"{name} is not JSON")


def write_hooks(harness: str, path: Path) -> str:
    """Plan one config file and write it if that changes anything: through a
    symlink to its target, in one rename, re-read first so a change another
    program made meanwhile is planned again, never overwritten. A line for
    the report."""
    for _ in range(3):
        try:
            text = path.read_text() if path.exists() else ""
        except OSError as e:
            raise Unworkable(f"cannot read it: {e}") from None
        try:
            root = json.loads(text, parse_constant=reject_constant) if text.strip() else {}
        except ValueError as e:
            raise Unworkable(f"it is not valid JSON: {e}") from None
        if not isinstance(root, dict):
            raise Unworkable("it is not a JSON object")
        added, fixed, removed = plan_hooks(harness, root)
        if not (added or fixed or removed):
            return "unchanged"
        real = path.resolve()
        tmp = real.with_name(f".{real.name}.museum-{os.getpid()}.tmp")
        try:
            real.parent.mkdir(parents=True, exist_ok=True)
            # Settings can hold secrets: a new file is owner-only from the start.
            mode = real.stat().st_mode & 0o777 if real.exists() else 0o600
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
            with os.fdopen(fd, "w") as f:
                f.write(json.dumps(root, indent=2, ensure_ascii=False) + "\n")
            os.chmod(tmp, mode)  # O_CREAT's mode passes through the umask  # noqa: PTH101
            if (real.read_text() if real.exists() else "") != text:
                continue
            tmp.replace(real)
        except OSError as e:
            raise Unworkable(f"cannot write it: {e}") from None
        finally:
            tmp.unlink(missing_ok=True)
        parts = [f"added {', '.join(added)}"] if added else []
        parts += [f"fixed {', '.join(fixed)}"] if fixed else []
        parts += [f"removed {', '.join(removed)}"] if removed else []
        return "; ".join(parts)
    raise Unworkable("another program kept changing it; run `museum init` again")


def install_hooks(only: set[str] | None, env: Mapping[str, str]) -> None:
    """museum's hook entries in each harness set up here, or in ONLY's."""
    for harness, (_, _, name, _, _) in HOOK_TARGETS.items():
        folder = harness_dir(harness, env)
        path = folder / name
        if only is not None and harness not in only:
            continue
        if only is None and not folder.is_dir() and not path.exists():
            continue
        try:
            print(f"hooks {harness}: {write_hooks(harness, path)} ({path})")
        except Unworkable as e:
            print(f"museum: hooks {harness}: left {path} alone: {e}", file=sys.stderr)


def link(dest: Path, target: Path, what: str) -> None:
    """A symlink museum owns; a real file or folder there is not ours."""
    if dest.exists() and not dest.is_symlink():
        print(f"museum: left {dest} (not a symlink)", file=sys.stderr)
        return
    if dest.is_symlink() and dest.readlink() == target:
        return
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.unlink(missing_ok=True)
    dest.symlink_to(target)
    print(f"linked {what}: {dest} -> {target}")


def install_skills(env: Mapping[str, str]) -> None:
    """The skill, linked into each harness that reads its own skills folder.
    cursor-agent also reads ~/.claude/skills and ~/.codex/skills (literal home
    paths), so it gets its own link only when neither holds the skill. pi
    loads it from the pi package; Muse installs skills with `muse skills`."""
    skill = ROOT / "skills" / "museum"
    for harness in ("claude", "codex"):
        folder = harness_dir(harness, env)
        if folder.is_dir():
            link(folder / "skills" / "museum", skill, f"{harness} skill")
    cursor = Path.home() / ".cursor"
    covered = any(
        (Path.home() / d / "skills/museum/SKILL.md").is_file() for d in (".claude", ".codex")
    )
    if cursor.is_dir():
        mine = cursor / "skills" / "museum"
        if not covered:
            link(mine, skill, "cursor-agent skill")
        elif mine.is_symlink():
            mine.unlink()
            print(f"removed {mine}: cursor-agent reads the claude or codex copy")
    # Older installs linked these into pi's discovery paths; with the package,
    # pi would load museum twice. Never put the skill back in ~/.agents/skills.
    # Before 0.2 the sync kept its bookkeeping in ~/.cache/museum.
    cache = Path.home() / ".cache/museum"
    if cache.is_dir() and {p.name for p in cache.iterdir()} <= {
        "state",
        "lock",
        "last-start",
        "pending",
    }:
        shutil.rmtree(cache)
        print(f"removed {cache}: the sync's state moved to {state_dir()}")
    for old in (
        Path.home() / ".agents/skills/museum",
        Path.home() / ".pi/agent/extensions/museum.ts",
    ):
        if old.is_symlink():
            old.unlink()
            print(f"removed old link {old}")


def is_museum(folder: Path) -> bool:
    """A museum folder: a checkout or a copy of the package."""
    try:
        name = json.loads((folder / "package.json").read_text()).get("name")
    except (OSError, ValueError, AttributeError):
        return False
    return name in ("museum", "@mu-crew/museum")


def npm_install() -> bool:
    """A copy of the npm package (npm's global one, or pi's), not a checkout."""
    return ROOT.parts[-3:-1] == ("node_modules", "@mu-crew")


def install_path() -> None:
    """`museum` on PATH for tmux, harness hooks and you. npm's bin link
    provides it for a global install; a checkout gets ~/.local/bin/museum.
    A ~/.local/bin/museum link to another museum (a hand-made link to a
    checkout, museum 0.4.0's into pi's copy) is an older install's: it goes,
    or is pointed here, so it cannot shadow this one."""
    mine = Path.home() / ".local/bin/museum"
    want = ROOT / "bin" / "museum"
    stale = mine.is_symlink() and mine.resolve() != want.resolve()
    if stale and (is_museum(mine.resolve().parent.parent) or not mine.exists()):
        mine.unlink()
        print(f"removed {mine}: an older install's link")
    if not npm_install():
        link(mine, want, "museum")
    problem = path_problem()
    if problem:
        print(f"museum: {problem}", file=sys.stderr)


def path_problem() -> str:
    """What is wrong with `museum` on PATH, or ""."""
    want = ROOT / "bin" / "museum"
    found = shutil.which("museum")
    if found is None:
        # npm's bin folder for a global install: <prefix>/lib/node_modules/@mu-crew/museum.
        bin_dir = ROOT.parents[3] / "bin" if npm_install() else want.parent
        return f"`museum` is not on PATH; add {bin_dir}"
    if Path(found).resolve() != want.resolve():
        return f"`museum` on PATH is {Path(found).resolve()}, not this one ({want})"
    return ""


NPM_SOURCE = "npm:@mu-crew/museum"


def pi_packages() -> list[tuple[str, Path]]:
    """`pi list`'s museum packages: (source, folder)."""
    r = run(["pi", "list"])
    out, source = [], ""
    for line in r.output.splitlines() if r.code == 0 else []:
        if line.startswith("    ") and source:
            folder = Path(line.strip())
            if is_museum(folder):
                out.append((source, folder))
        elif line.startswith("  ") and not line.startswith("   "):
            source = line.strip()
    return out


def check_pi() -> None:
    for line in pi_problems():
        print(f"pi: {line}")


def pi_problems() -> list[str]:
    """What pi needs, as commands to run: museum never edits pi's package
    list, as `mu init` does not. pi loads museum's extension and skill from
    one package, `npm:@mu-crew/museum` for an npm install (registered once
    with `pi install`) or the checkout itself; any other museum package it
    loads is an older install's, and loads the extension twice."""
    if not shutil.which("pi"):
        return []
    out = []
    want = NPM_SOURCE if npm_install() else str(ROOT)

    def mine(source: str, folder: Path) -> bool:
        return source == NPM_SOURCE if npm_install() else folder.resolve() == ROOT.resolve()

    packages = pi_packages()
    if not any(mine(source, folder) for source, folder in packages):
        out.append(f"run `pi install {want}` once, for museum's extension and skill")
    for source, folder in packages:
        if not mine(source, folder):
            # pi stores a local source relative to its settings file, and reads
            # one given to `pi remove` relative to the cwd: name it by folder.
            local = not re.match(r"^(npm|git|https?):", source)
            out.append(
                f"also loads museum from {folder}; run `pi remove {folder if local else source}`"
            )
    return out


def first_config(store: str | None, machine: str | None) -> Path:
    """config.toml, written once from STORE [MACHINE]; later runs keep it."""
    path = config_path()
    if sys.version_info >= (3, 11):  # noqa: UP036 (see load_config)
        convert_legacy(path)
    if path.exists():
        if store:
            print(f"museum: kept {path}; edit it to change the store", file=sys.stderr)
        return path
    if not store:
        raise ConfigError("first run needs the store: museum init host:/path (or /path)")
    host, sep, folder = store.partition(":") if ":" in store else ("", "", store)
    if sep and not host:
        raise ConfigError(f"no host before the colon in {store}: host:/path, or /path")
    if not folder.startswith("/"):
        raise ConfigError(f"the store folder must be absolute: {folder}")
    name = machine or socket.gethostname().split(".")[0]
    if name in (".", "..") or any(ch.isspace() or ch < " " for ch in name):
        raise ConfigError(f"the machine name is a plain folder name: {name!r}")
    # A taken name means another machine, or an old install, owns that folder:
    # naming it explicitly is the caller saying the reuse is intended, so only
    # the default name is checked. A store host that cannot answer is not a
    # free name.
    if not machine:
        if sep:
            code = run([*SSH, host, f"test -d {shlex.quote(f'{folder}/{name}')}"]).code
            if code not in (0, 1):
                raise ConfigError(
                    f"cannot reach {host} to check whether {name} is taken; fix ssh, "
                    f"or name this machine: museum init {store} <name>"
                )
            taken = code == 0
        else:
            taken = Path(folder, name).is_dir()
        if taken:
            raise ConfigError(
                f"{store}/{name} already exists: museum init {store} {name} if it is this "
                f"machine's, else museum init {store} <unique-name>"
            )
    c = Config(name, host if sep else None, folder.rstrip("/") or "/", False, find_rsync())
    # load_config's rules decide, so init never writes a config the sync rejects.
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".new")
    tmp.write_text(toml(c))
    try:
        load_config(tmp)
    except ConfigError as e:
        tmp.unlink()
        raise ConfigError(str(e).replace(str(tmp), "the config")) from None
    if not sep:
        # The sync never creates a local store folder, so a forgotten host
        # fails; this is the one time it is created, on purpose.
        Path(folder).mkdir(parents=True, exist_ok=True)
    tmp.replace(path)
    print(f"wrote {path}")
    return path


def line_buffered() -> None:
    """stdout in order with stderr and child processes, when it is a pipe."""
    if isinstance(sys.stdout, io.TextIOWrapper):
        sys.stdout.reconfigure(line_buffering=True)


def init(argv: list[str]) -> int:
    p = argparse.ArgumentParser(prog="museum init", description="Set this machine up for museum.")
    p.add_argument(
        "store", nargs="?", help="first run: host:/path for an ssh store, /path for a local one"
    )
    p.add_argument(
        "machine", nargs="?", help="this machine's folder in the store (default: hostname -s)"
    )
    hooks = p.add_mutually_exclusive_group()
    hooks.add_argument(
        "--hooks",
        metavar="LIST",
        help=f"write hook entries for these even when not set up yet ({', '.join(HOOK_TARGETS)}, all)",
    )
    hooks.add_argument(
        "--no-hooks", action="store_true", help="leave every harness's hook config alone"
    )
    ns = p.parse_args(argv)
    line_buffered()
    only = None
    if ns.hooks:
        only = set(HOOK_TARGETS) if ns.hooks == "all" else set(ns.hooks.split(","))
        if unknown := only - set(HOOK_TARGETS):
            p.error(f"--hooks: unknown harness {min(unknown)}")
    os.chdir(HOME)
    try:
        first_config(ns.store, ns.machine)
    except ConfigError as e:
        print(f"museum: {e}", file=sys.stderr)
        return 1
    if not ns.no_hooks:
        install_hooks(only, os.environ)
    # Before 0.6, SessionEnd hooks left this for `museum tick`.
    if (hook_dir() / "flush").exists():
        (hook_dir() / "flush").unlink()
        print(f"removed {hook_dir() / 'flush'}: hooks no longer start syncs")
    install_skills(os.environ)
    if harness_dir("muse", os.environ).is_dir():
        print("museum: Muse Code: add the skill with `muse skills`:", ROOT / "skills" / "museum")
    install_path()
    check_pi()
    # The first sync runs before the timer exists: the timer's first tick would
    # take the lock, and this sync would then exit 0 without its error.
    print("running first sync...")
    code = main(["--now"])
    print("ok" if code == 0 else "museum: first sync failed; see above and state.json")
    if timer_install() != 0:
        print("museum: could not install the timer", file=sys.stderr)
    return code


def status() -> int:
    """This machine's museum and last sync, then every machine's (museum-search machines)."""
    line_buffered()
    info = version_info()
    print(f"museum {version_label(info)} ({info['source']}: {ROOT})")
    try:
        doc = json.loads((state_dir() / "state.json").read_text())
        when = time.strftime("%Y-%m-%d %H:%M", time.localtime(int(doc.get("time", 0))))
        result = "ok" if doc.get("status") == "ok" else f"failed: {doc.get('message', '')}"
        if doc.get("status") != "ok" and doc.get("last_ok"):
            ok = time.strftime("%Y-%m-%d %H:%M", time.localtime(int(doc["last_ok"])))
            result += f" (last ok {ok})"
        print(f"last sync: {when} {result}\n")
    except (OSError, ValueError, TypeError):
        print("last sync: none yet\n")
    search = ROOT / "skills" / "museum" / "scripts" / "museum-search"
    return subprocess.run([sys.executable, str(search), "machines"], check=False).returncode


# --- doctor: every part of this machine's setup, each with its fix ---
#
# Read-only. Nearly every fix is `museum init`, which leaves what is right
# alone, so there is no --fix. It runs init's own checks (hooks, PATH, pi)
# without writing, so the two never disagree.

# ---- museum tick and its timer ----

LABEL = "museum.tick"
PERIOD = 300  # seconds between the timer's ticks


def session_roots(src: Path, sources: tuple[Source, ...]) -> list[Path]:
    """Every folder a sync copies from: pi's sessions, the other harnesses',
    and the meta records hooks write."""
    return [src, *(source.root for source in sources), hook_dir() / "meta"]


def changed_since(roots: list[Path], since: float) -> Iterator[float]:
    """The mtime of each session file and meta record changed after `since`.
    A root that is itself a link is followed, as the copy follows it; links
    inside are not."""
    for root in roots:
        for folder, _, names in os.walk(root):
            for name in names:
                if not name.endswith((".jsonl", ".json")):
                    continue
                try:
                    mtime = (Path(folder) / name).stat().st_mtime
                except OSError:
                    continue
                if mtime > since:
                    yield mtime


def number(path: Path) -> int:
    """A file's number, 0 when it is missing or holds anything else."""
    try:
        return int(path.read_text().strip())
    except (OSError, ValueError):
        return 0


def tick() -> int:
    """Start a sync, detached, when one is due and a session changed. Run by
    the timer and a tmux status line, outside every harness sandbox; hooks
    only write meta records.

    Due when neither a sync nor an earlier check started in the last
    MUSEUM_INTERVAL seconds. The check writes its own stamp, so the walk runs
    once per interval however often a status line calls, and a sync that
    cannot start (no config, old Python) is not retried on every refresh: its
    error is in state.json already. Changed means a file newer than last-ok,
    whose mtime is when the last sync that worked started (mark_ok), so what a
    failed sync missed stays changed until one works. Reads no config: the
    sync it starts does, and records what is wrong with it."""
    state = state_dir()
    now = int(time.time())
    last = max(number(state / "last-start"), number(state / "last-tick"))
    try:
        interval = int(os.environ.get("MUSEUM_INTERVAL") or 600)
    except ValueError:
        interval = 600
    if now - last < interval:
        return 0
    try:
        state.mkdir(parents=True, exist_ok=True)
        (state / "last-tick").write_text(f"{now}\n")
    except OSError:
        return 0
    try:
        ok = (state / "last-ok").stat().st_mtime
    except OSError:
        ok = None  # no sync has worked yet: everything is a change
    roots = session_roots(pi_sessions(os.environ), harness_sources(os.environ))
    if ok is not None and next(changed_since(roots, ok), None) is None:
        return 0
    # Detached, in its own session, so a status line or a timer never waits
    # for rsync. The sync takes the node's lock, so a tick that races another
    # sync adds nothing.
    sync = os.environ.get("MUSEUM_SYNC")
    cmd = [sync] if sync else [sys.executable, str(Path(__file__).resolve())]
    subprocess.Popen(
        [*cmd, "--if-due"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        cwd=HOME,
        start_new_session=True,
    )
    return 0


def timer_kind() -> str:
    return os.environ.get("MUSEUM_TIMER_KIND") or (
        "launchd" if sys.platform == "darwin" else "systemd"
    )


def launchd_plist() -> Path:
    return Path.home() / "Library/LaunchAgents" / f"{LABEL}.plist"


def systemd_dir() -> Path:
    return Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "systemd/user"


def timer_env(env: Mapping[str, str]) -> dict[str, str]:
    """What the timer's environment gets from this one. PATH: launchd's and
    systemd's own leave out the Homebrew or user folders that hold python3
    3.11+. XDG_STATE_HOME and MUSEUM_STATE_DIR, when set, so its syncs share
    pi's state folder: the lock, the cursors and state.json. The harnesses'
    folder variables, when set and not empty, so it backs up the sessions
    they write: the timer does every sync."""
    out = {"PATH": env.get("PATH", "")}
    if "MUSEUM_STATE_DIR" in env:
        out["MUSEUM_STATE_DIR"] = env["MUSEUM_STATE_DIR"]
    for name in (
        "XDG_STATE_HOME",
        "PI_SESSIONS_DIR",
        "CLAUDE_CONFIG_DIR",
        "CODEX_HOME",
        "CURSOR_HOME",
    ):
        if env.get(name):
            out[name] = env[name]
    return out


def timer_install() -> int:
    me = str(ROOT / "bin" / "museum")
    env = timer_env(os.environ)
    kind = timer_kind()
    if kind == "launchd":
        plist = launchd_plist()
        plist.parent.mkdir(parents=True, exist_ok=True)
        job = {
            "Label": LABEL,
            "ProgramArguments": [me, "tick"],
            "StartInterval": PERIOD,
            "RunAtLoad": True,
            # The detached sync outlives `tick`, launchd's job.
            "AbandonProcessGroup": True,
            "EnvironmentVariables": env,
            "StandardOutPath": "/dev/null",
            "StandardErrorPath": "/dev/null",
        }
        plist.write_bytes(plistlib.dumps(job))
        domain = f"gui/{os.getuid()}"
        run(["launchctl", "bootout", f"{domain}/{LABEL}"])
        # bootout returns before launchd lets go of the job, and a bootstrap
        # that lands first fails, so wait for it to be gone.
        for _ in range(50):
            if run(["launchctl", "print", f"{domain}/{LABEL}"]).code != 0:
                break
            time.sleep(0.1)
        r = run(["launchctl", "bootstrap", domain, str(plist)])
        if r.code != 0:
            print(r.output, file=sys.stderr, end="")
            return 1
        print(f"installed {plist}")
        return 0
    if kind == "systemd":
        units = systemd_dir()
        units.mkdir(parents=True, exist_ok=True)

        def quoted(value: str) -> str:
            return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'

        lines = "".join(f"Environment={quoted(f'{k}={v}')}\n" for k, v in env.items())
        # KillMode=process: the detached sync outlives `tick`, the unit's process.
        (units / "museum-tick.service").write_text(
            "[Unit]\nDescription=museum: back up agent sessions if a sync is due\n\n"
            f"[Service]\nType=oneshot\nKillMode=process\n{lines}ExecStart={quoted(me)} tick\n"
        )
        (units / "museum-tick.timer").write_text(
            f"[Unit]\nDescription=museum: run museum tick every {PERIOD} seconds\n\n"
            f"[Timer]\nOnBootSec=60\nOnUnitActiveSec={PERIOD}\n\n"
            "[Install]\nWantedBy=timers.target\n"
        )
        for cmd in (["daemon-reload"], ["enable", "--now", "museum-tick.timer"]):
            r = run(["systemctl", "--user", *cmd])
            if r.code != 0:
                print(r.output, file=sys.stderr, end="")
                return 1
        print(f"installed {units / 'museum-tick.timer'}")
        return 0
    print(f"museum: unknown timer kind {kind}", file=sys.stderr)
    return 2


def timer_remove() -> int:
    kind = timer_kind()
    if kind == "launchd":
        run(["launchctl", "bootout", f"gui/{os.getuid()}/{LABEL}"])
        launchd_plist().unlink(missing_ok=True)
        return 0
    if kind == "systemd":
        run(["systemctl", "--user", "disable", "--now", "museum-tick.timer"])
        for name in ("museum-tick.service", "museum-tick.timer"):
            (systemd_dir() / name).unlink(missing_ok=True)
        run(["systemctl", "--user", "daemon-reload"])
        return 0
    print(f"museum: unknown timer kind {kind}", file=sys.stderr)
    return 2


# ---- museum doctor ----

STALE = 30 * 60  # a change unsynced for longer is a stale backup, as pi's footer says

# One call to the store host: whether the store is there, whether this
# machine's folder still has the old layout, and each machine's newest version
# marker. $1: the store folder, $2: this machine.
PROBE = r"""
cd "$1" 2> /dev/null || { echo nostore; exit 0; }
echo store
for d in "$2"/--*-- "$2"/*.jsonl; do
  [ -e "$d" ] && { echo old; break; }
done
for m in */; do
  [ -d "$m" ] || continue
  f=$(ls -t "$m.museum" 2> /dev/null | head -n 1)
  echo "version ${m%/} ${f%.json}"
done
exit 0
"""


class Report:
    def __init__(self) -> None:
        self.failed = 0
        self.warned = 0

    def line(self, mark: str, what: str, fix: str = "") -> None:
        print(f"{mark:5} {what}")
        if fix:
            print(f"      fix: {fix}")

    def ok(self, what: str) -> None:
        self.line("ok", what)

    def warn(self, what: str, fix: str = "") -> None:
        self.warned += 1
        self.line("warn", what, fix)

    def fail(self, what: str, fix: str = "") -> None:
        self.failed += 1
        self.line("FAIL", what, fix)


def ago(seconds: float) -> str:
    """2m, 3h, 4d."""
    m = int(seconds // 60)
    if m < 60:
        return f"{m}m"
    return f"{m // 60}h" if m < 48 * 60 else f"{m // 1440}d"


def release(label: str) -> tuple[int, ...]:
    """0.5.1+abc as (0, 5, 1), for comparing machines' versions."""
    return tuple(int(n) for n in re.findall(r"\d+", label.partition("+")[0]))


def timer_program() -> tuple[str, str]:
    """(problem, the program the timer runs). The problem is "" when the timer
    is installed and loaded."""
    kind = timer_kind()
    if kind == "launchd":
        plist = launchd_plist()
        if not plist.exists():
            return "no timer: not installed", ""
        r = run(["launchctl", "print", f"gui/{os.getuid()}/{LABEL}"])
        if r.code != 0:
            return f"timer {plist} is not loaded", ""
        m = re.search(r"^\s*program = (.+)$", r.output, re.MULTILINE)
        return "", m[1].strip() if m else ""
    if kind == "systemd":
        unit = systemd_dir() / "museum-tick.service"
        if not unit.exists():
            return "no timer: not installed", ""
        r = run(["systemctl", "--user", "is-active", "museum-tick.timer"])
        if r.output.strip() != "active":
            return f"timer museum-tick.timer is {r.output.strip() or 'not active'}", ""
        m = re.search(r'^ExecStart="?([^"\n]+?)"? tick$', unit.read_text(), re.MULTILINE)
        return "", m[1] if m else ""
    return f"unknown timer kind {kind}", ""


def unsynced(s: Settings, since: float) -> tuple[int, float]:
    """How many session files and meta records changed after `since`, as
    `museum tick` looks for them, and the oldest of their mtimes: each one's
    first unsynced change is no later, so that change waited at least since."""
    n, oldest = 0, time.time()
    for mtime in changed_since(session_roots(s.src, s.sources), since):
        n += 1
        oldest = min(oldest, mtime)
    return n, oldest


def doctor() -> int:
    line_buffered()
    r = Report()
    info = version_info()
    print(f"museum {version_label(info)} ({info['source']}: {ROOT})\n")
    try:
        s = settings()
    except ConfigError as e:
        r.fail(f"config: {e}", "museum init STORE")
        return 1
    c = s.config
    r.ok(f"config {config_path()}: machine {c.machine}, store {c.target()}")

    rsync = find_rsync(c.rsync_path)
    if rsync:
        r.ok(f"rsync 3: {rsync}")
    else:
        r.fail("rsync 3.x not found", "brew install rsync (macOS), then museum init")

    # The store, in one call.
    probe = None
    if c.host:
        ssh = SSH + NO_AUTH if c.ssh_mux_only else SSH
        if c.ssh_mux_only and run([*ssh, "-O", "check", c.host]).code != 0:
            r.fail(f"store: no ssh master for {c.host}", f"ssh -MNf {c.host}")
        else:
            cmd = f"sh -c {shlex.quote(PROBE)} probe {shlex.quote(c.path)} {shlex.quote(c.machine)}"
            out = run([*ssh, c.host, cmd])
            if out.code == 0:
                probe = out.output
            else:
                r.fail(f"store: cannot reach {c.host}: {error_line(out.output)}", f"ssh {c.host}")
    else:
        probe = run(["/bin/sh", "-c", PROBE, "probe", c.path, c.machine]).output
    if probe is not None:
        lines = probe.splitlines()
        if "store" not in lines:
            r.fail(f"store: {c.path} does not exist", "check store.path, or museum init")
        else:
            r.ok(f"store: {c.target()} reachable")
            if "old" in lines:
                r.warn(
                    f"store: {c.machine}'s pi sessions are in the old layout",
                    "museum sync; a file it leaves differs from its copy in pi/ (the sync names it): compare and remove one",
                )
            mine = version_label(info)
            for v in (ln.split()[1:] for ln in lines if ln.startswith("version ")):
                if not v or v[0] == c.machine:
                    continue
                if len(v) == 1:
                    r.warn(
                        f"machine {v[0]} reports no version (museum before 0.4.0, or never synced)",
                        f"on {v[0]}: npm i -g @mu-crew/museum && museum init",
                    )
                elif release(v[1]) < release(mine):
                    r.warn(
                        f"machine {v[0]} runs museum {v[1]}",
                        f"on {v[0]}: npm update -g @mu-crew/museum && museum init",
                    )
                elif release(v[1]) > release(mine):
                    r.warn(
                        f"machine {v[0]} runs a newer museum, {v[1]}",
                        "npm update -g @mu-crew/museum && museum init",
                    )

    problem, program = timer_program()
    want = ROOT / "bin" / "museum"
    if problem:
        r.fail(problem, "museum timer install")
    elif program and Path(program).resolve() != want.resolve():
        r.fail(f"the timer runs {program}, not this museum", "museum init")
    else:
        r.ok("timer: runs museum tick every 5 minutes")
    if sys.platform.startswith("linux") and shutil.which("loginctl"):
        user = os.environ.get("USER") or ""
        linger = run(["loginctl", "show-user", user, "-p", "Linger", "--value"]).output.strip()
        if linger != "yes":
            r.warn(
                "linger is off: the timer stops while you are logged out", "loginctl enable-linger"
            )

    try:
        doc = json.loads((s.state / "state.json").read_text())
    except (OSError, ValueError):
        doc = {}
    if not isinstance(doc, dict):
        doc = {}
    last_ok = int(doc.get("last_ok") or 0)
    now = time.time()
    if doc.get("status") == "error":
        r.fail(f"last sync failed: {doc.get('message', '')}", "museum sync, to see the error")
    if not last_ok:
        if doc.get("status") == "ok":  # from before last_ok was recorded
            last_ok = int(doc.get("time") or 0)
        else:
            r.fail("no sync has worked yet", "museum sync")
    if last_ok:
        # Stale when a change has waited longer than a working timer lets it,
        # not when the last sync is old: an idle machine has nothing to sync.
        changed, oldest = unsynced(s, last_ok - 1)
        if changed and now - oldest > max(STALE, s.interval + 600):
            r.fail(
                f"backup stale: {changed} session files changed since the last good sync "
                f"{ago(now - last_ok)} ago, the first {ago(now - oldest)} ago",
                "the timer and store fixes above, then museum sync",
            )
        elif doc.get("status") == "ok":
            r.ok(f"last sync ok, {ago(now - last_ok)} ago; {changed} files changed since")

    for harness, (_, _, name, _, events) in HOOK_TARGETS.items():
        folder = harness_dir(harness, os.environ)
        path = folder / name
        if not folder.is_dir() and not path.exists():
            continue
        try:
            text = path.read_text() if path.exists() else ""
            root = json.loads(text, parse_constant=reject_constant) if text.strip() else {}
            if not isinstance(root, dict):
                raise Unworkable("it is not a JSON object")
            added, fixed, removed = plan_hooks(harness, root)
        except (OSError, ValueError, Unworkable) as e:
            r.fail(f"hooks {harness}: cannot read {path}: {e}", f"fix {path}")
            continue
        if added or fixed or removed:
            what = "; ".join(
                [f"missing {', '.join(added)}"] * bool(added)
                + [f"to fix {', '.join(fixed)}"] * bool(fixed)
                + [f"old {', '.join(removed)}"] * bool(removed)
            )
            r.warn(f"hooks {harness}: {what}", "museum init")
        else:
            r.ok(f"hooks {harness}: museum hook {harness} on {', '.join(events)}")

    for line in pi_problems():
        r.warn(f"pi: {line}")
    if problem := path_problem():
        r.warn(problem)

    print()
    if r.failed:
        print(f"{r.failed} problem(s), {r.warned} warning(s)")
    elif r.warned:
        print(f"backups work; {r.warned} warning(s)")
    else:
        print("all good")
    return 1 if r.failed else 0


def parse(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(
        prog="museum-sync",
        description="Back up local agent sessions to the museum store.",
    )
    mode = p.add_mutually_exclusive_group()
    mode.add_argument(
        "--if-due",
        action="store_true",
        help="sync only if the last sync started over MUSEUM_INTERVAL seconds ago",
    )
    mode.add_argument(
        "--now",
        action="store_true",
        help="sync now; if a sync is running, it runs again after (the default)",
    )
    mode.add_argument("--version", action="store_true", help="print the museum version")
    mode.add_argument(
        "--hook",
        metavar="HARNESS",
        help=f"run as a harness hook ({', '.join(HOOKED)}), the payload on stdin",
    )
    return p.parse_args(argv)


def main(argv: list[str]) -> int:
    if argv[:1] == ["init"]:
        return init(argv[1:])
    if argv[:1] == ["status"]:
        return status()
    if argv[:1] == ["doctor"]:
        return doctor()
    if argv[:1] == ["tick"]:
        return tick()
    if argv[:1] == ["timer"] and argv[1:] in (["install"], ["remove"]):
        return timer_install() if argv[1] == "install" else timer_remove()
    ns = parse(argv)
    if ns.version:
        info = version_info()
        print(f"museum {version_label(info)} ({info['source']}: {ROOT})")
        return 0
    if ns.hook:
        return hook(ns.hook, sys.stdin)
    if_due = ns.if_due
    # pi starts this in its own cwd, often a mu workspace deleted since, and
    # rsync exits 3 when getcwd() fails. Every path here is absolute.
    os.chdir(HOME)
    state = state_dir()
    state.mkdir(parents=True, exist_ok=True)
    try:
        s = settings()
    except ConfigError as e:
        # Recorded like a failed sync, so pi's footer shows it at once.
        record(state, "error", str(e))
        print(f"museum: {e}", file=sys.stderr)
        return 1
    # Marked BEFORE trying the lock, so a holder that is mid-sync sees it.
    if not if_due:
        (s.state / "pending").touch()
    rsync = find_rsync(s.config.rsync_path)
    fd = os.open(s.state / "lock", os.O_WRONLY | os.O_CREAT, 0o644)
    ok, synced = True, False
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            break
        # The interval gates only the first round: a sync this caller just ran
        # is not a reason to run again, only a `pending` mark is.
        while due(s, if_due):
            done = sync_once(s, rsync)
            ok, synced = ok and done, synced or done
            if_due = False
        # Under the lock, so one sync at a time writes the index. A flush
        # that arrives meanwhile leaves `pending`, and the loop below syncs it.
        if synced:
            index(s)
            synced = False
        fcntl.flock(fd, fcntl.LOCK_UN)
        # A --now caller may have set `pending` after our last check but before
        # the unlock, then found the lock taken and left. Take it back and sync
        # for it.
        if not (s.state / "pending").exists():
            break
    return 0 if ok else 1


def guarded(argv: list[str]) -> int:
    """main, with a crash recorded like a failed sync: pi shows only what this
    script writes, so a traceback that wrote nothing would leave it silent."""
    try:
        return main(argv)
    except Exception as e:
        if argv[:1] in (["doctor"], ["status"]):  # read-only: they record nothing
            raise
        with contextlib.suppress(OSError):
            record(state_dir(), "error", f"museum-sync crashed: {type(e).__name__}: {e}")
        raise


if __name__ == "__main__":
    sys.exit(guarded(sys.argv[1:]))
