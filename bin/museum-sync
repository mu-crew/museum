#!/usr/bin/env python3
"""Back up local pi sessions to the museum store. Append-only: nothing is ever deleted.

  museum-sync --if-due   sync if the last one started over MUSEUM_INTERVAL ago
  museum-sync [--now]    sync now; if a sync is already running, it runs again after

Many pi agents on one node call this at once, so at most one sync runs per node.
The lock is flock(2) on a file descriptor: it dies with its holder, so a crash or
reboot cannot leave it held. A caller that finds the lock taken exits 0 at once;
with --now it first leaves a `pending` mark, and the holder syncs again before it
lets go.

Config: ~/.config/museum/config.toml

  machine = "my-laptop"      this machine's folder in the store: <store>/<machine>/

  [store]
  host = "devbox"            the store host, over ssh; leave it out for a local store
  path = "/data/museum"      the store folder, absolute, on the store host
  ssh_mux_only = false       sync only through an ssh ControlMaster that is already
                             open, never a new connection: for a store host whose
                             login needs a security-key touch or other human step

A machine still on the old KEY=value `config` is converted to config.toml on its
first sync, and the old file is kept as config.old.
"""

from __future__ import annotations

import argparse
import contextlib
import fcntl
import json
import os
import re
import shlex
import shutil
import socket
import subprocess
import sys
import time
from pathlib import Path
from typing import NamedTuple

HOME = Path.home()
# Exit status of copy() when ssh_mux_only is set and no master is running.
NO_MASTER = 90
# rsync's "some files vanished before they could be transferred": fine here.
RSYNC_VANISHED = 24
# BatchMode: never prompt. The timeouts bound a hung connection, which would
# otherwise hold the lock (and every later sync on this node) indefinitely.
SSH = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10"]
SSH += ["-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=3"]
# Mux-only: a session over a master skips auth, so disabling every method
# changes nothing there, but if the master dies between the check and rsync,
# the fresh connection fails instead of asking for a key touch.
NO_AUTH = [
    f"-o{m}=no"
    for m in (
        "PubkeyAuthentication",
        "PasswordAuthentication",
        "KbdInteractiveAuthentication",
        "GSSAPIAuthentication",
        "HostbasedAuthentication",
    )
]


# --- config: the same in museum-search; test_config checks they match ---


class ConfigError(Exception):
    pass


class Config(NamedTuple):
    machine: str
    host: str | None
    path: str
    ssh_mux_only: bool

    def target(self) -> str:
        """The store folder in rsync's syntax: host:/path or /path."""
        return f"{self.host}:{self.path}" if self.host else self.path


def config_path() -> Path:
    return Path(os.environ.get("MUSEUM_CONFIG", Path.home() / ".config/museum/config.toml"))


def load_config(path: Path) -> Config:
    """config.toml, checked strictly: a typo is an error, not a default."""
    # Deliberately unreachable on the 3.11 target: an older python3 found on
    # PATH gets this message, in pi's footer too, not an ImportError.
    if sys.version_info < (3, 11):  # noqa: UP036
        raise ConfigError(
            f"needs Python 3.11+ for tomllib; {sys.executable} is {sys.version.split()[0]}"
        )
    import tomllib

    try:
        doc = tomllib.loads(path.read_text())
    except FileNotFoundError:
        raise ConfigError(f"missing {path}; run install.sh") from None
    except (OSError, tomllib.TOMLDecodeError) as e:
        raise ConfigError(f"{path}: {e}") from None

    def table(value: object, where: str, keys: set[str]) -> dict[str, object]:
        if not isinstance(value, dict):
            raise ConfigError(f"{path}: {where} must be a table")
        unknown = sorted(set(value) - keys)
        if unknown:
            raise ConfigError(f"{path}: unknown key {where}.{unknown[0]}".replace(" .", " "))
        return value

    def text(value: object, key: str) -> str:
        if not isinstance(value, str) or not value:
            raise ConfigError(f"{path}: {key} must be a non-empty string")
        return value

    top = table(doc, "", {"machine", "store"})
    store = table(top.get("store"), "store", {"host", "path", "ssh_mux_only"})
    machine = text(top.get("machine"), "machine")
    if "/" in machine:
        raise ConfigError(f"{path}: machine is a folder name, without /")
    host = text(store["host"], "store.host") if "host" in store else None
    if host and (":" in host or "/" in host):
        raise ConfigError(f"{path}: store.host is an ssh host; put the folder in store.path")
    folder = text(store.get("path"), "store.path")
    if not folder.startswith("/"):
        raise ConfigError(f"{path}: store.path must be absolute")
    mux = store.get("ssh_mux_only", False)
    if not isinstance(mux, bool):
        raise ConfigError(f"{path}: store.ssh_mux_only must be true or false")
    if mux and not host:
        raise ConfigError(f"{path}: store.ssh_mux_only needs store.host")
    return Config(machine, host, folder.rstrip("/") or "/", mux)


# --- end config ---


TEMPLATE = """\
# museum: https://github.com/mu-crew/museum

# This machine's folder in the store: sessions go to <store path>/<machine>/.
# Pinned at install, so a hostname change keeps using the same folder.
machine = {machine}

[store]
# The store is on another host, over ssh, when `host` is set, and in a folder
# on this machine when it is not. Only `host` decides.
#
#   ssh:    host = "devbox"            local:  (no host line)
#           path = "/data/museum"              path = "/data/museum"
#
# `path` is absolute, on whichever host holds the store. A local store's
# folder must already exist, so a forgotten `host` line fails instead of
# quietly backing up to this machine.
{host}path = {path}

# ssh only. true: sync only over an ssh ControlMaster that is already open,
# never a new connection, for a store host whose login needs a security-key
# touch or another human step. Open one with `ssh -MNf <host>`.
ssh_mux_only = {mux}
"""


def toml(c: Config) -> str:
    """A Config as config.toml, commented. JSON strings are valid TOML basic
    strings. install.sh writes the same file from its own copy of TEMPLATE."""

    def q(s: str) -> str:
        return json.dumps(s, ensure_ascii=False)

    return TEMPLATE.format(
        machine=q(c.machine),
        host=f"host = {q(c.host)}\n" if c.host else "",
        path=q(c.path),
        mux="true" if c.ssh_mux_only else "false",
    )


def convert_legacy(path: Path) -> None:
    """Write config.toml from the old KEY=value `config` beside it, once, and
    keep the old file as config.old. Remove when no machine has one left."""
    old = path.with_name("config")
    if path.exists() or not old.is_file():
        return
    values = {}
    for line in old.read_text().splitlines():
        for word in shlex.split(line, comments=True):
            key, eq, value = word.partition("=")
            if eq:
                values[key] = value
    store = values.get("STORE", "")
    host, sep, folder = store.partition(":") if ":" in store else ("", "", store)
    legacy = Config(
        machine=values.get("NAME") or socket.gethostname().split(".")[0],
        host=host if sep else None,
        path=folder,
        ssh_mux_only=bool(values.get("SSH_MUX_ONLY")),
    )
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(toml(legacy))
    tmp.replace(path)
    old.replace(old.with_name("config.old"))


class Settings(NamedTuple):
    config: Config
    src: Path
    state: Path
    interval: int
    retry_delay: int


class Result(NamedTuple):
    code: int
    output: str


def state_dir() -> Path:
    if "MUSEUM_STATE_DIR" in os.environ:
        return Path(os.environ["MUSEUM_STATE_DIR"])
    xdg = os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state"
    return Path(xdg) / "museum"


def settings() -> Settings:
    path = config_path()
    if sys.version_info >= (3, 11):  # noqa: UP036 (see load_config)
        convert_legacy(path)
    env = os.environ
    return Settings(
        config=load_config(path),
        src=Path(env.get("PI_SESSIONS_DIR", HOME / ".pi/agent/sessions")),
        state=state_dir(),
        interval=int(env.get("MUSEUM_INTERVAL", "600")),
        retry_delay=int(env.get("MUSEUM_RETRY_DELAY", "30")),
    )


def find_rsync() -> str | None:
    """The first rsync 3: PATH's, then Homebrew's. macOS /usr/bin/rsync is
    openrsync, which lacks --append-verify."""
    for candidate in (shutil.which("rsync"), "/opt/homebrew/bin/rsync", "/usr/local/bin/rsync"):
        if not candidate or not os.access(candidate, os.X_OK):
            continue
        try:
            out = subprocess.run(
                [candidate, "--version"], capture_output=True, text=True, check=False
            ).stdout
        except OSError:
            continue
        if re.match(r"rsync\s+version 3", out):
            return candidate
    return None


def run(cmd: list[str]) -> Result:
    """stdout and stderr merged, in the order the command wrote them. The lock
    fd is not inheritable (PEP 446), so neither ssh nor rsync, nor an orphan
    they leave behind, can keep holding the lock."""
    try:
        p = subprocess.run(
            cmd,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            errors="replace",
            check=False,
        )
    except OSError as e:
        return Result(1, f"{cmd[0]}: {e}")
    return Result(p.returncode, p.stdout)


def copy(s: Settings, rsync: str) -> Result:
    c = s.config
    ssh = SSH + NO_AUTH if c.ssh_mux_only else SSH
    extra = []
    if c.host:
        # `-O check` only asks the local control socket; it never connects.
        if c.ssh_mux_only and run([*ssh, "-O", "check", c.host]).code != 0:
            return Result(NO_MASTER, f"no ssh master for {c.host} (run: ssh -MNf {c.host})")
        # The remote mkdir rides rsync's own connection, so a sync opens one
        # ssh connection, not two.
        extra = [f"--rsync-path=mkdir -p {shlex.quote(f'{c.path}/{c.machine}')} && rsync"]
    else:
        # Only the machine's folder is created, never the store folder: a
        # missing one most likely means a forgotten `host` line, and creating
        # it would back up to this machine and report success.
        if not Path(c.path).is_dir():
            return Result(1, f"store.path {c.path} does not exist here (is store.host missing?)")
        try:
            Path(c.path, c.machine).mkdir(exist_ok=True)
        except OSError as e:
            return Result(1, f"mkdir: {e}")
    r = run(
        [
            rsync,
            "-a",
            "--append-verify",
            "--timeout=120",
            "--include=*/",
            "--include=*.jsonl",
            "--exclude=*",
            *extra,
            "-e",
            " ".join(ssh),
            f"{s.src}/",
            f"{c.target()}/{c.machine}/",
        ]
    )
    return Result(0, r.output) if r.code == RSYNC_VANISHED else r


def error_line(output: str) -> str:
    """ssh's or the remote mkdir's line says why; rsync's last line after it is
    only "connection unexpectedly closed" / "protocol data stream"."""
    lines = [line for line in output.splitlines() if line.strip()]
    why = [line for line in lines if re.match(r"(ssh|mkdir): ", line)]
    return (why or lines or [""])[-1]


def write(path: Path, text: str) -> None:
    """Atomically, so a pi polling the file never reads half of it."""
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(text)
    tmp.replace(path)


def warning(status: str, message: str) -> str:
    """pi's footer label, empty while backups work. Every pi on the node shows
    this file as it is, so the rule for the label lives here, in one place."""
    return f"museum: backup failing: {message}"[:120] if status == "error" else ""


def record(state: Path, status: str, message: str) -> None:
    """state.json: the last sync's result, and the footer label every pi shows."""
    message = " ".join(message.split())
    doc = {
        "status": status,
        "time": int(time.time()),
        "message": message,
        "warning": warning(status, message),
    }
    write(state / "state.json", json.dumps(doc) + "\n")


def sync_once(s: Settings, rsync: str | None) -> bool:
    (s.state / "pending").unlink(missing_ok=True)
    (s.state / "last-start").write_text(f"{int(time.time())}\n")
    if rsync is None:
        record(s.state, "error", "rsync 3.x not found (macOS: brew install rsync)")
        return False
    r = copy(s, rsync)
    # One retry, for a blip, only in mux-only mode with a live master: there it
    # costs no human step. A fresh connection may need a key touch, and a
    # missing master will not appear in retry_delay seconds.
    if r.code != 0 and s.config.ssh_mux_only and r.code != NO_MASTER:
        print(f"{r.output}museum: retrying in {s.retry_delay}s", file=sys.stderr)
        time.sleep(s.retry_delay)
        r = copy(s, rsync)
    if r.code == 0:
        record(s.state, "ok", "")
        return True
    record(s.state, "error", error_line(r.output))
    print(r.output, file=sys.stderr, end="")
    return False


def due(s: Settings, if_due: bool) -> bool:
    if (s.state / "pending").exists():
        return True
    if not if_due:
        return False
    try:
        last = int((s.state / "last-start").read_text().strip())
    except (OSError, ValueError):
        last = 0
    return time.time() - last >= s.interval


def parse(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(
        prog="museum-sync",
        description="Back up local pi sessions to the museum store.",
    )
    mode = p.add_mutually_exclusive_group()
    mode.add_argument(
        "--if-due",
        action="store_true",
        help="sync only if the last sync started over MUSEUM_INTERVAL seconds ago",
    )
    mode.add_argument(
        "--now",
        action="store_true",
        help="sync now; if a sync is running, it runs again after (the default)",
    )
    return p.parse_args(argv)


def main(argv: list[str]) -> int:
    if_due = parse(argv).if_due
    # pi starts this in its own cwd, often a mu workspace deleted since, and
    # rsync exits 3 when getcwd() fails. Every path here is absolute.
    os.chdir(HOME)
    state = state_dir()
    state.mkdir(parents=True, exist_ok=True)
    try:
        s = settings()
    except ConfigError as e:
        # Recorded like a failed sync, so pi's footer shows it at once.
        record(state, "error", str(e))
        print(f"museum: {e}", file=sys.stderr)
        return 1
    # Marked BEFORE trying the lock, so a holder that is mid-sync sees it.
    if not if_due:
        (s.state / "pending").touch()
    rsync = find_rsync()
    fd = os.open(s.state / "lock", os.O_WRONLY | os.O_CREAT, 0o644)
    ok = True
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            break
        # The interval gates only the first round: a sync this caller just ran
        # is not a reason to run again, only a `pending` mark is.
        while due(s, if_due):
            ok = sync_once(s, rsync) and ok
            if_due = False
        fcntl.flock(fd, fcntl.LOCK_UN)
        # A --now caller may have set `pending` after our last check but before
        # the unlock, then found the lock taken and left. Take it back and sync
        # for it.
        if not (s.state / "pending").exists():
            break
    return 0 if ok else 1


def guarded(argv: list[str]) -> int:
    """main, with a crash recorded like a failed sync: pi shows only what this
    script writes, so a traceback that wrote nothing would leave it silent."""
    try:
        return main(argv)
    except Exception as e:
        with contextlib.suppress(OSError):
            record(state_dir(), "error", f"museum-sync crashed: {type(e).__name__}: {e}")
        raise


if __name__ == "__main__":
    sys.exit(guarded(sys.argv[1:]))
