#!/bin/sh
# Back up local pi sessions to the museum store. Append-only: nothing is ever deleted.
#
#   museum-sync --if-due   sync if the last one started over MUSEUM_INTERVAL ago
#   museum-sync [--now]    sync now; if a sync is already running, it runs again after
#
# Many pi agents on one node call this at once, so at most one sync runs per
# node. The lock is a kernel lock on a file descriptor (flock on Linux, lockf on
# macOS): it dies with its holder, so a crash or reboot cannot leave it held. A
# caller that finds the lock taken exits 0 at once; with --now it first leaves a
# `pending` mark, and the holder syncs again before it lets go.
#
# Config: ~/.config/museum/config (shell syntax)
#   STORE=host:/path   or   STORE=/local/path
#   NAME=my-laptop     (optional, defaults to `hostname -s`)
#   SSH_MUX_ONLY=1     (optional) sync only through a running ssh ControlMaster,
#                      never a fresh connection: for hosts whose auth needs a
#                      security-key touch or other human step
set -eu

CONFIG="${MUSEUM_CONFIG:-$HOME/.config/museum/config}"
[ -f "$CONFIG" ] || {
  echo "museum: missing $CONFIG (set STORE=host:/path)" >&2
  exit 1
}
# shellcheck source=/dev/null
. "$CONFIG"
: "${STORE:?museum: STORE not set in $CONFIG}"
NAME="${NAME:-$(hostname -s)}"
SRC="${PI_SESSIONS_DIR:-$HOME/.pi/agent/sessions}"
STATE_DIR="${MUSEUM_STATE_DIR:-$HOME/.cache/museum}"
INTERVAL="${MUSEUM_INTERVAL:-600}"
RETRY_DELAY="${MUSEUM_RETRY_DELAY:-30}"
SSH_MUX_ONLY="${SSH_MUX_ONLY:-}"

case "${1:---now}" in
  --now) MODE=now ;;
  --if-due) MODE=if-due ;;
  *)
    echo "usage: museum-sync [--if-due | --now]" >&2
    exit 2
    ;;
esac

# The first rsync 3 found: PATH's, then Homebrew's. macOS /usr/bin/rsync is
# openrsync, which lacks --append-verify.
RSYNC=
for r in "$(command -v rsync || true)" /opt/homebrew/bin/rsync /usr/local/bin/rsync; do
  if [ -x "$r" ] && "$r" --version 2> /dev/null | grep -q '^rsync  *version 3'; then
    RSYNC=$r
    break
  fi
done

mkdir -p "$STATE_DIR"
# Marked BEFORE trying the lock, so a holder that is mid-sync sees it.
[ "$MODE" = now ] && : > "$STATE_DIR/pending"

# A non-blocking lock on fd 9, released when the fd closes or the script dies.
if command -v flock > /dev/null 2>&1; then
  lock() { flock -n 9; }
elif [ -x /usr/bin/lockf ]; then
  lock() { /usr/bin/lockf -s -t 0 9; }
else
  echo "museum: no flock or lockf on this system" >&2
  exit 1
fi
open_lock() { exec 9> "$STATE_DIR/lock"; }
unlock() { exec 9>&-; }

due() {
  [ -f "$STATE_DIR/pending" ] && return 0
  [ "$MODE" = if-due ] || return 1
  last=$(cat "$STATE_DIR/last-start" 2> /dev/null || true)
  [ $(($(date +%s) - ${last:-0})) -ge "$INTERVAL" ]
}

record() { # status message
  printf 'status=%s\ntime=%s\nmessage=%s\n' "$1" "$(date +%s)" "$2" > "$STATE_DIR/state.tmp"
  mv "$STATE_DIR/state.tmp" "$STATE_DIR/state"
}

# BatchMode: never prompt. The timeouts bound a hung connection, which would
# otherwise hold the lock (and every later sync on this node) indefinitely.
SSH="ssh -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=3"
# Mux-only: a session over a master skips auth, so disabling every method
# changes nothing there, but if the master dies between the check and rsync,
# the fresh connection fails instead of asking for a key touch.
[ -n "$SSH_MUX_ONLY" ] && SSH="$SSH -o PubkeyAuthentication=no -o PasswordAuthentication=no -o KbdInteractiveAuthentication=no -o GSSAPIAuthentication=no -o HostbasedAuthentication=no"

# Exit status of copy when SSH_MUX_ONLY is set and no master is running.
NO_MASTER=90

# errexit does not apply inside `$(copy)` used in a condition, hence the
# explicit `|| return`. rsync 24 is "a file vanished mid-run", which is fine.
# For an ssh store, the remote mkdir rides rsync's own connection
# (--rsync-path), so a sync opens one ssh connection, not two.
copy() {
  case "$STORE" in
    *:*)
      host=${STORE%%:*}
      # `-O check` only asks the local control socket; it never connects.
      if [ -n "$SSH_MUX_ONLY" ] && ! $SSH -O check "$host" 2> /dev/null; then
        echo "no ssh master for $host (run: ssh -MNf $host)"
        return "$NO_MASTER"
      fi
      set -- --rsync-path="mkdir -p '${STORE#*:}/$NAME' && rsync"
      ;;
    *)
      mkdir -p "$STORE/$NAME" || return
      set --
      ;;
  esac
  "$RSYNC" -a --append-verify --timeout=120 --include='*/' --include='*.jsonl' --exclude='*' \
    "$@" -e "$SSH" "$SRC/" "$STORE/$NAME/" || [ $? -eq 24 ]
}

# The subshell closes the lock fd first, so neither it nor ssh/rsync hold
# the lock. Otherwise a killed script's orphans keep it, and every sync on
# the node silently skips until they die.
attempt() {
  st=0
  out=$(
    exec 9>&-
    copy 2>&1
  ) || st=$?
  return "$st"
}

sync_once() {
  rm -f "$STATE_DIR/pending"
  date +%s > "$STATE_DIR/last-start"
  if [ -z "$RSYNC" ]; then
    record error "rsync 3.x not found (macOS: brew install rsync)"
    return 1
  fi
  attempt && {
    record ok ""
    return 0
  }
  # One retry, for a blip, only in mux-only mode with a live master: there it
  # costs no human step. A fresh connection may need a key touch, and a
  # missing master will not appear in $RETRY_DELAY seconds.
  if [ -n "$SSH_MUX_ONLY" ] && [ "$st" -ne "$NO_MASTER" ]; then
    printf '%s\nmuseum: retrying in %ss\n' "$out" "$RETRY_DELAY" >&2
    sleep "$RETRY_DELAY"
    attempt && {
      record ok ""
      return 0
    }
  fi
  # ssh's or the remote mkdir's line says why; rsync's last line after it is only
  # "connection unexpectedly closed" / "protocol data stream".
  msg=$(printf '%s\n' "$out" | grep -E '^(ssh|mkdir): ' | tail -n 1)
  record error "${msg:-$(printf '%s' "$out" | tail -n 1)}"
  printf '%s\n' "$out" >&2
  return 1
}

rc=0
open_lock
while lock; do
  while due; do sync_once || rc=1; done
  unlock
  # A --now caller may have set `pending` after our last check but before the
  # unlock, then found the lock taken and left. Take it back and sync for it.
  [ -f "$STATE_DIR/pending" ] || break
  open_lock
done
exit "$rc"
