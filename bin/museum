#!/usr/bin/env python3
"""museum: the one command that tmux, timers and harness hooks call.

  museum tick            start a sync, detached, if sessions changed; prints nothing
  museum hook HARNESS    a harness hook (claude, codex, cursor-agent, muse, pi); payload on stdin
  museum sync [ARGS]     museum-sync, in the foreground (--now, --if-due)
  museum timer install   run `museum tick` every 5 minutes (launchd or systemd)
  museum timer remove    stop and remove that timer
  museum init [STORE [MACHINE]]  set this machine up: config, hooks, skills, timer
  museum status          this machine's last sync, and every machine's museum
  museum doctor          check this machine's setup, with the fix for each problem
  museum version         this museum's version and where it runs from

`tick` is the only thing that starts a sync on its own, from outside every
harness sandbox: the timer, and a tmux status line's #(museum tick), which the
tmux server runs. Harness hooks, which may run in a sandbox that refuses rsync
and ssh, only write meta records.

Every command is museum-sync's: this only names them, and runs the museum-sync
beside it (through the symlink npm puts on PATH), or $MUSEUM_SYNC. It runs on
any python3, so that an old one reaches museum-sync, which says what is wrong
in pi's footer.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

VERBS = {
    "tick": ["tick"],
    "status": ["status"],
    "doctor": ["doctor"],
    "version": ["--version"],
}


def sync_path() -> str:
    return os.environ.get("MUSEUM_SYNC") or str(Path(__file__).resolve().parent / "museum-sync")


def usage() -> int:
    lines = (__doc__ or "").splitlines()
    sys.stderr.write("\n".join(line[2:] for line in lines[2:11]) + "\n")
    return 2


def args(argv: list[str]) -> list[str] | None:
    """museum-sync's arguments for a museum command line, None for a bad one."""
    verb, rest = (argv[0], argv[1:]) if argv else ("", [])
    if verb in VERBS and not rest:
        return VERBS[verb]
    if verb == "hook" and len(rest) == 1:
        return ["--hook", rest[0]]
    if verb == "sync":
        return rest
    if verb in ("init", "setup"):
        return ["init", *rest]
    if verb == "timer" and rest in (["install"], ["remove"]):
        return ["timer", *rest]
    return None


def main() -> int:
    argv = sys.argv[1:]
    # For pi's extension, when `museum` on PATH is a version manager's shim.
    if argv == ["sync-path"]:
        print(sync_path())
        return 0
    rest = args(argv)
    if rest is None:
        return usage()
    sync = sync_path()
    try:
        os.execv(sync, [sync, *rest])
    except OSError as e:
        sys.stderr.write(f"museum: cannot run {sync}: {e}\n")
        return 126


if __name__ == "__main__":
    sys.exit(main())
