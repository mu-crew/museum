#!/bin/sh
# Lint, format, type and test gate (make check). Turn it on with `make hooks`.
# Escape hatch: git commit --no-verify.
set -e

if ! git diff --cached --name-only --diff-filter=ACMR | grep -qE '^(bin/|skills/museum/scripts/|test/|install\.sh$|\.githooks/|Makefile$|\.editorconfig$|pyproject\.toml$)'; then
	exit 0
fi

if ! command -v uvx >/dev/null 2>&1; then
	echo "pre-commit: uvx missing, skipping checks (install uv)" >&2
	exit 0
fi

make -s check
